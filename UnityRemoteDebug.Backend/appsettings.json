{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "HealthEndpoint": {
    "Url": "http://0.0.0.0:11808"
  },
  "BackendRegistration": {
    "BackendKind": "UnityRemoteDebug"
  },
  "GatewayListener": {
    "IPAddress": "::1",
    "Port": 11708,
    "UseTls": false,
    "CertificateSubjectName": "localhost",
    "Backlog": 512,
    "HandshakeTimeoutMilliseconds": 5000
  },
  "RemoteDebugClients": {
    "AllowedCapabilities": "LogStreaming",
    "HeartbeatIntervalMilliseconds": 15000,
    "ClientTimeoutMilliseconds": 45000
  },
  "MasterConnection": {
    "Enabled": true,
    "IPAddress": "::1",
    "Port": 11601,
    "UseTls": false,
    "ServerName": "localhost",
    "NodeId": "unity-remotedebug-backend-local",
    "DisplayName": "Unity RemoteDebug Backend",
    "SharedSecret": "development-node-auth-secret",
    "ReconnectDelayMilliseconds": 5000,
    "HandshakeTimeoutMilliseconds": 5000
  }
}
