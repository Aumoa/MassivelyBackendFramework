@using Microsoft.AspNetCore.Components.Routing

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@Title</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            @foreach (var item in Items)
            {
                <NavLink class="nav-link" href="@item.Href" Match="NavLinkMatch.Prefix">
                    <span class="material-symbols-outlined" aria-hidden="true">@item.Icon</span>
                    <span style="margin-left: 4px;">@item.Text</span>
                </NavLink>
            }
        </div>
    </nav>
</div>

@code {
    public record struct NavMenuItem(string Text, string Icon, string Href);

    [Parameter]
    public string Title { get; set; } = string.Empty;
    [Parameter]
    public NavMenuItem[] Items { get; set; } = [];
}