@using System.IdentityModel.Tokens.Jwt
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (!IsAuthenticated)
{
    return;
}

<div class="usercard-container">
    <img src="@m_Picture" alt="Profile" class="profile-img" />

    <div class="user-info-panel">
        <div class="summary-panel">
            <img src="@m_Picture" alt="Profile" class="profile-img-large" />
            <div class="informations">
                <p class="user-info-name">@m_Name</p>
                <p class="user-info-email">@m_Email</p>
                <div class="sub-row">
                    <span class="user-info-sub">@m_ShortSub</span>
                    <button class="copy-sub-btn @(m_SubCopied ? "copied" : "")" onclick="@OnClick_CopySubAsync" title="@(m_SubCopied ? Strings.PROFILECARD_COPY_SUB_COPIED : Strings.PROFILECARD_COPY_SUB)">
                        <span class="material-symbols-outlined">@(m_SubCopied ? "check" : "content_copy")</span>
                    </button>
                </div>
            </div>
        </div>
        <hr />
        <div class="functions">
            <button onclick="@OnClick_ManageAccountAsync">
                <span class="material-symbols-outlined">manage_accounts</span>
                <span>@Strings.PROFILECARD_MANAGE_ACCOUNT</span>
            </button>
            <button onclick="@OnClick_Logout">
                <span class="material-symbols-outlined">logout</span>
                <span>@Strings.PROFILECARD_LOGOUT</span>
            </button>
        </div>
    </div>
</div>

@code {
    private bool m_Initialized;
    private AuthenticationState? m_State;

    private bool IsAuthenticated => m_State?.User.Identity?.IsAuthenticated == true;

    private string m_Sub = string.Empty;
    private string m_Name = string.Empty;
    private string m_Email = string.Empty;
    private string m_Picture = string.Empty;
    private string m_ShortSub = string.Empty;
    private bool m_SubCopied;

    protected override Task OnInitializedAsync()
    {
        if (!m_Initialized)
        {
            Auth.AuthenticationStateChanged += OnAuthenticationStateChanged;
            m_Initialized = true;
        }
        return Task.CompletedTask;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ReloadAuthenticationStateAsync();
        }

        return Task.CompletedTask;
    }

    private void ReloadAuthenticationStateAsync()
    {
        OnAuthenticationStateChanged(Auth.GetAuthenticationStateAsync());
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            m_State = await task;
            if (m_State == null)
            {
                m_Sub = string.Empty;
                m_Name = string.Empty;
                m_Email = string.Empty;
                m_Picture = string.Empty;
                m_ShortSub = string.Empty;
            }
            else
            {
                m_Sub = m_State.User.FindFirst("sub")?.Value ?? string.Empty;
                m_Name = m_State.User.FindFirst("name")?.Value ?? string.Empty;
                m_Email = m_State.User.FindFirst("email")?.Value ?? string.Empty;
                m_Picture = m_State.User.FindFirst("picture")?.Value ?? string.Empty;
                m_ShortSub = m_Sub.Length > 24 ? m_Sub[..24] + "..." : m_Sub;
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Auth.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        m_CopySubCts?.Cancel();
        m_CopySubCts?.Dispose();
        GC.SuppressFinalize(this);
    }

    private CancellationTokenSource? m_CopySubCts;

    private async Task OnClick_CopySubAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", m_Sub);

            m_CopySubCts?.Cancel();
            m_CopySubCts = new CancellationTokenSource();
            var cts = m_CopySubCts;

            m_SubCopied = true;
            StateHasChanged();

            await Task.Delay(1500, cts.Token);

            m_SubCopied = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // another copy was triggered; ignore
        }
        catch
        {
            // clipboard access may be unavailable in some contexts
        }
    }

    private async Task OnClick_ManageAccountAsync()
    {
        await JS.InvokeVoidAsync("openExternalUrl", "https://accounts.ayla.r-e.kr");
    }

    private void OnClick_Logout()
    {
        Nav.NavigateTo("/auth/logout", forceLoad: true);
    }
}