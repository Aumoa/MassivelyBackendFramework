@inject IStringLocalizer<MasterAdmin.Localizations.Strings> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@Strings.APP_TITLE</a>
    </div>
</div>

<input type="checkbox" title="@Strings.NAV_TOGGLE_TITLE" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-diagram-nav-menu" aria-hidden="true"></span> @Strings.NAV_OVERVIEW
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="connections">
                <span class="bi bi-key-nav-menu" aria-hidden="true"></span> @L["NAV_CONNECTIONS"]
            </NavLink>
        </div>
    </nav>
</div>
