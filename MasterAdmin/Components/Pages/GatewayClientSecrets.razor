@page "/gateway-client-secrets"
@attribute [Authorize(Policy = MasterAuthorizationPolicies.Admin)]
@inject IGatewayClientSecretCredentials Credentials

<PageTitle>@T("GATEWAY_CLIENT_SECRETS_TITLE")</PageTitle>

<section class="client-secrets-header">
    <div>
        <p class="eyebrow">@T("GATEWAY_CLIENT_SECRETS_EYEBROW")</p>
        <h1>@T("GATEWAY_CLIENT_SECRETS_TITLE")</h1>
        <p class="summary">@T("GATEWAY_CLIENT_SECRETS_SUMMARY")</p>
    </div>
</section>

<section class="client-secret-panel">
    <div class="panel-heading">
        <div>
            <h2>@FormTitle</h2>
            <p>@T("GATEWAY_CLIENT_SECRETS_FORM_DESCRIPTION")</p>
        </div>
        <button type="button" class="refresh-button" @onclick="ResetForm">
            @T("GATEWAY_CLIENT_SECRETS_NEW")
        </button>
    </div>

    <EditForm Model="Form" OnValidSubmit="SaveAsync" FormName="gateway-client-secret-credential">
        <DataAnnotationsValidator />
        <div class="client-secret-form">
            <label>
                <span>@T("GATEWAY_CLIENT_SECRETS_SUBJECT_ID")</span>
                <InputText @bind-Value="Form.SubjectId" maxlength="128" />
            </label>
            <label>
                <span>@T("GATEWAY_CLIENT_SECRETS_DISPLAY_NAME")</span>
                <InputText @bind-Value="Form.DisplayName" maxlength="256" />
            </label>
            <label class="toggle-row">
                <InputCheckbox @bind-Value="Form.Enabled" />
                <span>@T("GATEWAY_CLIENT_SECRETS_ENABLED")</span>
            </label>
            <button type="submit" class="refresh-button" disabled="@IsBusy">
                @SaveButtonText
            </button>
        </div>
        <ValidationSummary />
    </EditForm>
</section>

@if (!string.IsNullOrWhiteSpace(NewAccessToken))
{
    <section class="issued-token-panel" aria-live="polite">
        <div>
            <strong>@T("GATEWAY_CLIENT_SECRETS_TOKEN_CREATED")</strong>
            <span>@T("GATEWAY_CLIENT_SECRETS_TOKEN_DESCRIPTION")</span>
        </div>
        <code>@NewAccessToken</code>
    </section>
}

<section class="client-secret-panel">
    <div class="panel-heading">
        <div>
            <h2>@T("GATEWAY_CLIENT_SECRETS_LIST_TITLE")</h2>
            <p>@T("GATEWAY_CLIENT_SECRETS_LIST_DESCRIPTION")</p>
        </div>
        <button type="button" class="refresh-button" @onclick="LoadAsync" disabled="@IsBusy">
            @Strings.NODE_REFRESH
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="empty-state">
            <strong>@Strings.NODE_STATUS_ERROR_TITLE</strong>
            <span>@ErrorMessage</span>
        </div>
    }
    else if (Items.Length == 0)
    {
        <div class="empty-state">
            <strong>@T("GATEWAY_CLIENT_SECRETS_EMPTY_TITLE")</strong>
            <span>@T("GATEWAY_CLIENT_SECRETS_EMPTY_DESCRIPTION")</span>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>@T("GATEWAY_CLIENT_SECRETS_DISPLAY_NAME")</th>
                        <th>@T("GATEWAY_CLIENT_SECRETS_SUBJECT_ID")</th>
                        <th>@T("GATEWAY_CLIENT_SECRETS_TOKEN_ID")</th>
                        <th>@T("GATEWAY_CLIENT_SECRETS_STATUS")</th>
                        <th>@T("GATEWAY_CLIENT_SECRETS_UPDATED")</th>
                        <th>@T("GATEWAY_CLIENT_SECRETS_ACTIONS")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        <tr>
                            <td>@item.DisplayName</td>
                            <td><code>@item.SubjectId</code></td>
                            <td><code>@item.TokenId</code></td>
                            <td>@(item.Enabled ? T("GATEWAY_CLIENT_SECRETS_ENABLED") : T("GATEWAY_CLIENT_SECRETS_DISABLED"))</td>
                            <td>@item.UpdatedAt</td>
                            <td>
                                <div class="action-row">
                                    <button type="button" class="table-button" @onclick="() => Edit(item)" disabled="@IsBusy">
                                        @T("GATEWAY_CLIENT_SECRETS_EDIT")
                                    </button>
                                    <button type="button" class="table-button" @onclick="() => RotateAsync(item.Id)" disabled="@IsBusy">
                                        @T("GATEWAY_CLIENT_SECRETS_ROTATE")
                                    </button>
                                    <button type="button" class="table-button danger" @onclick="() => RemoveAsync(item.Id)" disabled="@IsBusy">
                                        @T("GATEWAY_CLIENT_SECRETS_REMOVE")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private GatewayClientSecretCredentialInfo[] Items { get; set; } = [];

    private ClientSecretFormModel Form { get; set; } = new();

    private long? EditingId { get; set; }

    private string? NewAccessToken { get; set; }

    private string? ErrorMessage { get; set; }

    private bool IsBusy { get; set; }

    private string FormTitle => EditingId.HasValue
        ? T("GATEWAY_CLIENT_SECRETS_EDIT_TITLE")
        : T("GATEWAY_CLIENT_SECRETS_CREATE_TITLE");

    private string SaveButtonText => IsBusy
        ? T("GATEWAY_CLIENT_SECRETS_SAVING")
        : EditingId.HasValue
            ? T("GATEWAY_CLIENT_SECRETS_SAVE")
            : T("GATEWAY_CLIENT_SECRETS_CREATE");

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await RunBusyAsync(async () =>
        {
            Items = await Credentials.GetCredentialsAsync();
        });
    }

    private async Task SaveAsync()
    {
        await RunBusyAsync(async () =>
        {
            var input = new GatewayClientSecretCredentialInput(
                Form.SubjectId.Trim(),
                Form.DisplayName.Trim(),
                Form.Enabled);

            if (EditingId.HasValue)
            {
                await Credentials.UpdateCredentialAsync(EditingId.Value, input);
            }
            else
            {
                var created = await Credentials.CreateCredentialAsync(input);
                NewAccessToken = created.AccessToken;
            }

            ResetForm();
            Items = await Credentials.GetCredentialsAsync();
        });
    }

    private async Task RotateAsync(long id)
    {
        await RunBusyAsync(async () =>
        {
            NewAccessToken = await Credentials.RotateSecretAsync(id);
            Items = await Credentials.GetCredentialsAsync();
        });
    }

    private async Task RemoveAsync(long id)
    {
        await RunBusyAsync(async () =>
        {
            await Credentials.RemoveCredentialAsync(id);
            Items = await Credentials.GetCredentialsAsync();
            if (EditingId == id)
            {
                ResetForm();
            }
        });
    }

    private void Edit(GatewayClientSecretCredentialInfo item)
    {
        EditingId = item.Id;
        NewAccessToken = null;
        Form = new ClientSecretFormModel
        {
            SubjectId = item.SubjectId,
            DisplayName = item.DisplayName,
            Enabled = item.Enabled
        };
    }

    private void ResetForm()
    {
        EditingId = null;
        Form = new ClientSecretFormModel();
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        if (IsBusy)
        {
            return;
        }

        try
        {
            IsBusy = true;
            ErrorMessage = null;
            await action();
        }
        catch (Exception e)
        {
            ErrorMessage = e.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static string T(string key)
    {
        return Strings.ResourceManager.GetString(key, Strings.Culture) ?? key;
    }

    private sealed class ClientSecretFormModel
    {
        [Required]
        [StringLength(128)]
        public string SubjectId { get; set; } = string.Empty;

        [Required]
        [StringLength(256)]
        public string DisplayName { get; set; } = string.Empty;

        public bool Enabled { get; set; } = true;
    }
}
