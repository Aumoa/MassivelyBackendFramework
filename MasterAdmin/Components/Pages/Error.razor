@page "/Error"
@using System.Diagnostics

<PageTitle>@Strings.ERROR_PAGE_TITLE</PageTitle>

<h1 class="text-danger">@Strings.ERROR_PAGE_TITLE</h1>
<h2 class="text-danger">@Strings.ERROR_PAGE_MESSAGE</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Strings.ERROR_REQUEST_ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>@Strings.ERROR_DEVELOPMENT_MODE_TITLE</h3>
<p>@Strings.ERROR_DEVELOPMENT_MODE_DESCRIPTION</p>
<p>
    <strong>@Strings.ERROR_DEVELOPMENT_MODE_WARNING</strong>
</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
