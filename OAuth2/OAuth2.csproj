<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.8" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="MySql.Data" Version="9.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OAuth2.Controllers\OAuth2.Controllers.csproj" />
    <ProjectReference Include="..\OAuth2.SQL\OAuth2.SQL.csproj" />
    <ProjectReference Include="..\Services\OAuth2.Core\OAuth2.Core.csproj" />
    <ProjectReference Include="..\SQLMigration\SQLMigration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Components\AppStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppStrings.resx</DependentUpon>
    </Compile>
    <Compile Update="Localizations\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Components\AppStrings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>AppStrings.Designer.cs</LastGenOutput>
      <DependentUpon>App.razor</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Components\AppStrings.ko.resx">
      <DependentUpon>AppStrings.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Localizations\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
