{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Register": {
    "AllowedEmailDomains": []
  },
  "DataProtection": {
    "RedisConnectionString": "localhost:6379"
  },
  "OAuth2": {
    "Host": {
      "ClientId": "oauth2",
      "Secret": "REPLACE_WITH_SECURE_SECRET",
      "Uri": "https://localhost:7009"
    },
    "MySql": {
      "Server": "localhost",
      "Port": 3306,
      "Database": "MassivelyBackendFramework__OAuth2",
      "User": "REPLACE_WITH_DB_USER",
      "Password": "REPLACE_WITH_DB_PASSWORD"
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "DbIndex": 0
    },
    "Jwt": {
      "Issuer": "https://localhost:7009",
      "ExpiresIn": "00:30:00",
      "RefreshTokenExpiresIn": "365.00:00:00",
      "PrivateKeyPath": "enter_your_private_key.pem",
      "PublicKeyPath": "enter_your_public_key.pem"
    }
  }
}
