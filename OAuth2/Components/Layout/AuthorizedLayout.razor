@inherits LayoutComponentBase
@layout MainLayout

<div class="page">
    <div class="sidebar">
        <NavMenu Title="OAuth2" Items="Items" />
    </div>

    <main>
        <div class="top-row px-4">
            <ProfileCard />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private static readonly NavMenu.NavMenuItem[] Items =
    [
        new(Strings.NAVMENU_LABEL_MANAGE_MYACCOUNT, "manage_accounts", "/manage-my-account", false),
        new(Strings.NAVMENU_LABEL_MANAGE_APPLICATIONS, "app_registration", "/manage-applications", false),
        new(Strings.NAVMENU_LABEL_MANAGE_ROLES, "shield_person", "/manage-roles", false)
    ];
}