@using Microsoft.AspNetCore.Components.Authorization
@using OAuth2.Components.Redirects
@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <RedirectToMain />
    </Authorized>
    <NotAuthorized>
        <div class="page-center">
            @Body
        </div>
    </NotAuthorized>
</AuthorizeView>