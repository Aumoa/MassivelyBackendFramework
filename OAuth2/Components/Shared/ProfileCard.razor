@using OAuth2.Services
@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Nav

<span>@Auth.Name</span>
<span style="padding-left: 6px;">(@Auth.Email)</span>
<button type="button" class="link-button" onclick="@OnLogout">@Strings.PROFILECARD_LOGOUT</button>

@code {
    private void OnLogout()
    {
        Nav.NavigateTo("/auth/logout", forceLoad: true);
    }
}