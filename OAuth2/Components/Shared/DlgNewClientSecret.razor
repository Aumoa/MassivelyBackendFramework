@using OAuth2.Localizations
@inject IJSRuntime JS

<Dialog @ref="m_Ref">
    <div class="dlg-header">
        <div class="dlg-header-icon">
            <span class="material-symbols-outlined">key</span>
        </div>
        <div class="dlg-header-text">
            <h2 class="dlg-title">@Strings.MANAGE_APPLICATION_NEWSECRET_TITLE</h2>
        </div>
    </div>
    <hr class="dlg-divider" />
    <div class="dlg-body">
        <div class="secret-warning">
            <span class="material-symbols-outlined secret-warning-icon">warning</span>
            <p class="secret-warning-text">@Strings.MANAGE_APPLICATION_NEWSECRET_WARNING</p>
        </div>
        <div class="secret-field-group">
            <label class="secret-field-label">@Strings.MANAGE_APPLICATION_NEWSECRET_SECRET_LABEL</label>
            <div class="secret-value-row">
                <code class="secret-value">@m_Secret</code>
                <button type="button" class="btn-copy @(m_IsCopied ? "btn-copy--copied" : "")" @onclick="OnCopyAsync">
                    <span class="material-symbols-outlined">@(m_IsCopied ? "check" : "content_copy")</span>
                    @(m_IsCopied ? Strings.MANAGE_APPLICATION_NEWSECRET_COPIED : Strings.MANAGE_APPLICATION_NEWSECRET_COPY)
                </button>
            </div>
        </div>
    </div>
    <div class="dlg-footer">
        <button type="button" class="btn-primary" @onclick="CloseAsync">
            @Strings.MANAGE_APPLICATION_NEWSECRET_CLOSE
        </button>
    </div>
</Dialog>

@code {
    private Dialog m_Ref = null!;
    private string m_Secret = string.Empty;
    private bool m_IsCopied;

    [Parameter]
    public EventCallback OnClose { get; set; }

    public async Task ShowAsync(string secret)
    {
        m_Secret = secret;
        m_IsCopied = false;
        await m_Ref.ShowAsync();
    }

    public async Task CloseAsync()
    {
        m_Secret = string.Empty;
        m_IsCopied = false;
        await m_Ref.CloseAsync();
        await OnClose.InvokeAsync();
    }

    private async Task OnCopyAsync()
    {
        if (string.IsNullOrEmpty(m_Secret))
        {
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", m_Secret);
        m_IsCopied = true;
        StateHasChanged();
    }
}
