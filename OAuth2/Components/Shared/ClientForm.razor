@using OAuth2.Localizations
@using OAuth2.Services
@using OAuth2.DTO
@inject IClientClaims Claims
@inject IClientUserGroups UserGroups
@inject IAccounts Accounts
@inject IClients Clients
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="form-wrapper">
    @if (IsNewMode)
    {
        <div class="form-section">
            <div class="section-header">
                <h3 class="section-title">@Strings.MANAGE_APPLICATION_SETTINGS_SECTION</h3>
            </div>
            <div class="section-body">
                <div class="field-row">
                    <label class="field-label">@Strings.NEWCLIENT_FORM_LABEL_NAME</label>
                    <div class="field-input">
                        <FloatingInput Type="text" Placeholder="@Strings.NEWCLIENT_FORM_LABEL_NAME" Value="@Name" ValueChanged="@NameChanged" />
                    </div>
                </div>
            </div>
        </div>
        <div class="form-actions">
            <button type="button" class="btn-secondary" @onclick="OnCancelAsync" disabled="@IsSubmitting">@Strings.CLIENTFORM_BUTTON_CANCEL</button>
            <button type="button" class="btn-primary" @onclick="() => OnSubmit.InvokeAsync()" disabled="@IsSubmitting">
                @(IsSubmitting ? Strings.NEWCLIENT_BUTTON_PROCESSING : Strings.NEWCLIENT_BUTTON_REGISTER)
            </button>
        </div>
    }
    else
    {
        <div class="form-section">
            <div class="section-header">
                <h3 class="section-title">@Strings.MANAGE_APPLICATION_SETTINGS_SECTION</h3>
            </div>
            <div class="section-body">
                <div class="field-row">
                    <label class="field-label">@Strings.NEWCLIENT_FORM_LABEL_NAME</label>
                    <div class="field-value">@Name</div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-header">
                <div class="section-header-text">
                    <h3 class="section-title">@Strings.MANAGE_APPLICATION_REDIRECT_SECTION</h3>
                    <p class="section-desc">@Strings.MANAGE_APPLICATION_REDIRECT_SECTION_DESC</p>
                </div>
            </div>
            <div class="section-body">
                <div class="redirect-uris-container">
                    @for (int i = 0; i < m_RedirectUris.Length; i++)
                    {
                        var index = i;
                        <div class="uri-row">
                            <div class="uri-input-wrap">
                                <FloatingInput Type="text" Placeholder="https://example.com" Value="@m_RedirectUris[index].Uri" ValueChanged="@(value => UpdateRedirectUri(index, value))" />
                            </div>
                            <button type="button" class="btn-icon-action btn-save" disabled="@(!m_RedirectUris[index].IsChanged)" @onclick="() => ApplyRedirectUriAsync(index)" title="@Strings.CLIENTFORM_BUTTON_APPLY">
                                <span class="material-symbols-outlined">save</span>
                            </button>
                            <button type="button" class="btn-icon-action btn-delete" @onclick="() => DeleteRedirectUriAsync(index)" title="@Strings.CLIENTFORM_BUTTON_REMOVE">
                                <span class="material-symbols-outlined">delete</span>
                            </button>
                        </div>
                    }
                </div>
                <div class="section-add-action">
                    <button type="button" class="btn-text-add" @onclick="AddRedirectUriAsync">
                        <span class="material-symbols-outlined">add</span>
                        @Strings.CLIENTFORM_BUTTON_ADD_URI
                    </button>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-header">
                <div class="section-header-text">
                    <h3 class="section-title">@Strings.MANAGE_APPLICATION_USERGROUPS_SECTION</h3>
                    <p class="section-desc">@Strings.MANAGE_APPLICATION_USERGROUPS_SECTION_DESC</p>
                </div>
            </div>
            <div class="section-body">
                @foreach (var userGroups in m_UserGroups.GroupBy(g => g.AccountId))
                {
                    var firstItem = userGroups.First();
                    <div class="user-group-block">
                        <div class="user-group-account">
                            <span class="material-symbols-outlined user-icon">person</span>
                            <span class="user-account-id">@firstItem.AccountLoginId</span>
                            <span class="user-account-sub">@firstItem.AccountId</span>
                        </div>
                        @for (int i = 0; i < userGroups.Count(); i++)
                        {
                            var group = userGroups.ElementAt(i);
                            var groupIndex = Array.IndexOf(m_UserGroups, group);
                            <div class="uri-row">
                                <div class="uri-input-wrap">
                                    <FloatingInput Type="text" Placeholder="Group name" Value="@m_UserGroups[groupIndex].Group" ValueChanged="@(value => UpdateUserGroup(groupIndex, value))" />
                                </div>
                                <button type="button" class="btn-icon-action btn-save" disabled="@(!m_UserGroups[groupIndex].IsChanged)" @onclick="() => ApplyUserGroupAsync(groupIndex)" title="@Strings.CLIENTFORM_BUTTON_APPLY">
                                    <span class="material-symbols-outlined">save</span>
                                </button>
                                <button type="button" class="btn-icon-action btn-delete" @onclick="() => DeleteUserGroupAsync(groupIndex)" title="@Strings.CLIENTFORM_BUTTON_REMOVE">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                }
                <div class="add-user-group-panel">
                    <div class="add-user-group-inputs">
                        <FloatingInput @bind-Value="m_NewUserIdentifier" HasError="@m_HasNewUserError" Type="text" Placeholder="User ID / Email / Sub" />
                        <FloatingInput @bind-Value="m_NewGroupName" Type="text" Placeholder="Group name" />
                    </div>
                    @if (!string.IsNullOrEmpty(m_NewUserErrorMessage))
                    {
                        <div class="add-user-group-error">
                            <span class="material-symbols-outlined add-user-group-error-icon">error</span>
                            <span>@m_NewUserErrorMessage</span>
                        </div>
                    }
                    <button @onclick="AddUserGroupAsync" type="button" class="btn-text-add">
                        <span class="material-symbols-outlined">person_add</span>
                        @Strings.CLIENTFORM_BUTTON_ADD
                    </button>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-header">
                <div class="section-header-text">
                    <h3 class="section-title">@Strings.MANAGE_APPLICATION_SECRETS_SECTION</h3>
                    <p class="section-desc">@Strings.MANAGE_APPLICATION_SECRETS_SECTION_DESC</p>
                </div>
                <button type="button" class="btn-text-add secrets-add-btn" @onclick="OnAddSecretAsync">
                    <span class="material-symbols-outlined">add</span>
                    @Strings.MANAGE_APPLICATION_SECRETS_NEW_BUTTON
                </button>
            </div>
            <div class="section-body">
                @if (m_Secrets.Length == 0)
                {
                    <div class="secrets-empty">
                        <span class="material-symbols-outlined secrets-empty-icon">key_off</span>
                        <span class="secrets-empty-text">@Strings.MANAGE_APPLICATION_SECRETS_SECTION</span>
                    </div>
                }
                else
                {
                    <div class="secrets-list">
                        @foreach (var secret in m_Secrets)
                        {
                            var secretId = secret.Id;
                            <div class="secret-row">
                                <span class="material-symbols-outlined secret-key-icon">key</span>
                                <div class="secret-meta">
                                    <span class="secret-id">••••••••••••••••</span>
                                    <span class="secret-created">@Strings.MANAGE_APPLICATION_SECRETS_CREATED_AT: @secret.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <button type="button" class="btn-icon-action btn-delete" @onclick="() => RemoveSecretAsync(secretId)" title="@Strings.MANAGE_APPLICATION_SECRETS_REMOVE">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<DlgNewClientSecret @ref="m_DlgNewSecret" OnClose="OnNewSecretDialogClosedAsync" />

@code {
    public struct RedirectUri
    {
        public long Id { get; set; }
        public string OriginUri { get; set; }
        public string Uri { get; set; }

        public bool IsChanged => OriginUri != Uri;
    }

    public struct UserGroupItem
    {
        public long Id { get; set; }
        public string AccountId { get; set; }
        public string AccountLoginId { get; set; }
        public string OriginGroup { get; set; }
        public string Group { get; set; }

        public bool IsChanged => OriginGroup != Group;
    }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public EventCallback<string?> NameChanged { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public bool IsNewMode { get; set; } = true;

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    private RedirectUri[] m_RedirectUris = [];
    private UserGroupItem[] m_UserGroups = [];
    private ClientSecretInfo[] m_Secrets = [];
    private DlgNewClientSecret m_DlgNewSecret = null!;
    private string? m_NewUserIdentifier;
    private string? m_NewGroupName;
    private bool m_HasNewUserError;
    private string? m_NewUserErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            return;
        }

        await RefreshRedirectUrisAsync(Id);
        await RefreshUserGroupsAsync(Id);
        await RefreshSecretsAsync(Id);
    }

    public async Task AddRedirectUriAsync()
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            return;
        }

        await Claims.AddClaimAsync(Id, "redirect_uri", "https://example.com");
        await RefreshRedirectUrisAsync(Id);
    }

    private void UpdateRedirectUri(int index, string value)
    {
        if (index >= 0 && index < m_RedirectUris.Length)
        {
            m_RedirectUris[index].Uri = value;
        }
    }

    private async Task ApplyRedirectUriAsync(int index)
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            return;
        }

        if (index < 0 || index >= m_RedirectUris.Length)
        {
            return;
        }

        ref var uri = ref m_RedirectUris[index];
        if (!uri.IsChanged)
        {
            return;            
        }

        await Claims.ModifyClaimAsync(uri.Id, uri.Uri);
        await RefreshRedirectUrisAsync(Id);
    }

    public async Task DeleteRedirectUriAsync(int index)
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            return;
        }

        if (index < 0 || index >= m_RedirectUris.Length)
        {
            return;
        }

        ref var uri = ref m_RedirectUris[index];
        await Claims.RemoveClaimAsync(uri.Id);
        await RefreshRedirectUrisAsync(Id);
    }

    private async ValueTask RefreshRedirectUrisAsync(string id)
    {
        var claims = await Claims.GetClaimsAsync(id);
        m_RedirectUris = [.. claims.Where(c => c.Name == "redirect_uri").Select(c => new RedirectUri
            {
                Id = c.Id,
                OriginUri = c.Value!,
                Uri = c.Value!
            })];
    }

    public async Task AddUserGroupAsync()
    {
        m_HasNewUserError = false;
        m_NewUserErrorMessage = null;

        if (string.IsNullOrWhiteSpace(Id) || string.IsNullOrWhiteSpace(m_NewUserIdentifier) || string.IsNullOrWhiteSpace(m_NewGroupName))
        {
            return;
        }

        var sub = await Accounts.ResolveSubAsync(m_NewUserIdentifier.Trim());
        if (sub == null)
        {
            m_HasNewUserError = true;
            m_NewUserErrorMessage = Strings.CLIENTFORM_ERROR_USER_NOT_FOUND;
            return;
        }

        await UserGroups.AddClientUserGroupAsync(Id, sub, m_NewGroupName.Trim());
        m_NewUserIdentifier = null;
        m_NewGroupName = null;
        await RefreshUserGroupsAsync(Id);
    }

    private void UpdateUserGroup(int index, string value)
    {
        if (index >= 0 && index < m_UserGroups.Length)
        {
            m_UserGroups[index].Group = value;
        }
    }

    private async Task ApplyUserGroupAsync(int index)
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            return;
        }

        if (index < 0 || index >= m_UserGroups.Length)
        {
            return;
        }

        ref var group = ref m_UserGroups[index];
        if (!group.IsChanged)
        {
            return;
        }

        await UserGroups.ModifyClientUserGroupAsync(group.Id, group.Group);
        await RefreshUserGroupsAsync(Id);
    }

    public async Task DeleteUserGroupAsync(int index)
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            return;
        }

        if (index < 0 || index >= m_UserGroups.Length)
        {
            return;
        }

        ref var group = ref m_UserGroups[index];
        await UserGroups.RemoveClientUserGroupAsync(group.Id);
        await RefreshUserGroupsAsync(Id);
    }

    private async ValueTask RefreshUserGroupsAsync(string id)
    {
        var groups = await UserGroups.GetAllClientUserGroupsAsync(id);
        m_UserGroups = [.. groups.Select(g => new UserGroupItem
            {
                Id = g.Id,
                AccountId = g.AccountId,
                AccountLoginId = g.AccountLoginId,
                OriginGroup = g.Group,
                Group = g.Group
            })];
    }

    private Task OnCancelAsync()
    {
        Nav.NavigateTo("/manage-applications");
        return Task.CompletedTask;
    }

    private async ValueTask RefreshSecretsAsync(string id)
    {
        m_Secrets = await Clients.GetClientSecretsAsync(id);
    }

    private async Task OnAddSecretAsync()
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            return;
        }

        var secret = await Clients.NewClientSecretAsync(Id);
        await RefreshSecretsAsync(Id);
        await m_DlgNewSecret.ShowAsync(secret);
    }

    private async Task OnNewSecretDialogClosedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            await RefreshSecretsAsync(Id);
        }

        StateHasChanged();
    }

    private async Task RemoveSecretAsync(long secretId)
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", Strings.MANAGE_APPLICATION_SECRETS_REMOVE_CONFIRM);
        if (!confirmed)
        {
            return;
        }

        await Clients.RemoveClientSecretAsync(secretId);
        await RefreshSecretsAsync(Id);
    }
}
