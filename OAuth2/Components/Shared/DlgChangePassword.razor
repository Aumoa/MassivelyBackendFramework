@using OAuth2.Services
@using Microsoft.JSInterop
@inject IAccounts Accounts
@inject IAccesses Accesses
@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<Dialog @ref="m_Ref">
    <div class="dlg-header">
        <div class="dlg-header-icon">
            <span class="material-symbols-outlined">lock</span>
        </div>
        <div class="dlg-header-text">
            <h2 class="dlg-title">@Strings.MANAGEACCOUNTS_CHANGEPW_TITLE</h2>
        </div>
    </div>
    <hr class="dlg-divider" />
    <div class="dlg-body">
        <FloatingInput Type="password"
                       Placeholder="@Strings.MANAGEACCOUNTS_CHANGEPW_CURRENTPW"
                       Value="@m_CurrentPassword"
                       ValueChanged="@((v) => { m_CurrentPassword = v; ClearErrors(); })"
                       HasError="@m_HasCurrentPwError"
                       AutoComplete="current-password" />
        <FloatingInput Type="password"
                       Placeholder="@Strings.MANAGEACCOUNTS_CHANGEPW_NEWPW"
                       Value="@m_NewPassword"
                       ValueChanged="@((v) => { m_NewPassword = v; ClearErrors(); })"
                       HasError="@m_HasNewPwError"
                       AutoComplete="new-password" />
        <FloatingInput Type="password"
                       Placeholder="@Strings.MANAGEACCOUNTS_CHANGEPW_CONFIRMPW"
                       Value="@m_ConfirmPassword"
                       ValueChanged="@((v) => { m_ConfirmPassword = v; ClearErrors(); })"
                       HasError="@m_HasConfirmPwError"
                       AutoComplete="new-password" />
        @if (!string.IsNullOrEmpty(m_Error))
        {
            <div class="dlg-error">
                <span class="material-symbols-outlined dlg-error-icon">error</span>
                <span>@m_Error</span>
            </div>
        }
    </div>
    <div class="dlg-footer">
        <button @onclick="CloseAsync" class="btn-ghost" disabled="@m_IsSubmitting">
            @Strings.MANAGEACCOUNTS_CHANGE_CANCEL
        </button>
        <button @onclick="OnConfirmAsync" class="btn-primary" disabled="@m_IsSubmitting">
            @Strings.MANAGEACCOUNTS_CHANGE_CONFIRM
        </button>
    </div>
</Dialog>

@code {
    private const int kPasswordMinimumLength = 8;

    private Dialog m_Ref = null!;
    private string m_CurrentPassword = string.Empty;
    private string m_NewPassword = string.Empty;
    private string m_ConfirmPassword = string.Empty;
    private string m_Error = string.Empty;
    private bool m_HasCurrentPwError;
    private bool m_HasNewPwError;
    private bool m_HasConfirmPwError;
    private bool m_IsSubmitting;

    public async Task ShowAsync()
    {
        m_CurrentPassword = string.Empty;
        m_NewPassword = string.Empty;
        m_ConfirmPassword = string.Empty;
        m_Error = string.Empty;
        m_HasCurrentPwError = false;
        m_HasNewPwError = false;
        m_HasConfirmPwError = false;
        m_IsSubmitting = false;
        await m_Ref.ShowAsync();
    }

    public async Task CloseAsync()
    {
        await m_Ref.CloseAsync();
    }

    private void ClearErrors()
    {
        m_Error = string.Empty;
        m_HasCurrentPwError = false;
        m_HasNewPwError = false;
        m_HasConfirmPwError = false;
    }

    private async Task OnConfirmAsync()
    {
        if (m_IsSubmitting)
        {
            return;
        }

        ClearErrors();

        if (string.IsNullOrEmpty(m_CurrentPassword))
        {
            m_Error = Strings.MANAGEACCOUNTS_CHANGEPW_ERROR_CURRENTPWEMPTY;
            m_HasCurrentPwError = true;
            return;
        }

        if (string.IsNullOrEmpty(m_NewPassword))
        {
            m_Error = Strings.MANAGEACCOUNTS_CHANGEPW_ERROR_NEWPWEMPTY;
            m_HasNewPwError = true;
            return;
        }

        if (m_NewPassword.Length < kPasswordMinimumLength)
        {
            m_Error = string.Format(Strings.MANAGEACCOUNTS_CHANGEPW_ERROR_PWLENGTH, kPasswordMinimumLength);
            m_HasNewPwError = true;
            return;
        }

        if (m_NewPassword != m_ConfirmPassword)
        {
            m_Error = Strings.MANAGEACCOUNTS_CHANGEPW_ERROR_MISMATCHCONRIM;
            m_HasConfirmPwError = true;
            return;
        }

        if (m_CurrentPassword == m_NewPassword)
        {
            m_Error = Strings.MANAGEACCOUNTS_CHANGEPW_ERROR_NOTMODIFIED;
            m_HasNewPwError = true;
            return;
        }

        m_IsSubmitting = true;
        StateHasChanged();

        try
        {
            var verified = await Accesses.VerifyAsync(Auth.AccessToken ?? string.Empty);
            if (verified.HasValue == false || verified.Value.Id != Auth.Id)
            {
                await JS.InvokeVoidAsync("alert", Strings.ERROR_COMMON_AUTHENTICATION_EXPIRED);
                Nav.NavigateTo("/auth/logout", forceLoad: true);
                return;
            }

            if (!await Accounts.ChangePasswordAsync(Auth.Sub!, m_CurrentPassword, m_NewPassword))
            {
                m_Error = Strings.MANAGEACCOUNTS_CHANGEPW_ERROR_PASSWORDINCORRECT;
                m_HasCurrentPwError = true;
                return;
            }

            // Invalidate all existing tokens for this user so that any cached sessions
            // (stored in browser cookies as cached_jwt_*) cannot be used to log back in
            // without entering the new password.
            await Accesses.InvalidateAllTokensAsync(Auth.Sub!);

            await JS.InvokeVoidAsync("alert", Strings.MANAGEACCOUNTS_CHANGEPW_SUCCESS_MESSAGE);
            Nav.NavigateTo("/auth/logout", forceLoad: true);
        }
        finally
        {
            m_IsSubmitting = false;
            StateHasChanged();
        }
    }
}