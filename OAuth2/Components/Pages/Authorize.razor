@page "/authorize"
@layout MainLayout

<div class="login-form">
    <div style="display:flex; flex-direction:row; gap:10px; padding-bottom: 20px;">
        <h2 class="title">
            @Strings.LOGIN_FORM_TITLE
        </h2>
        <form class="input-form" @onsubmit="OnContinueAsync">
            <SelectorContainer View="m_RenderState">
                <SelectorView Key="RenderStates.Id">
                    <FloatingInput Type="text" Placeholder="@Strings.LOGIN_LABEL_ID" @bind-Value="m_ID" Input="@OnChangedAsync" HasError="@IdError" />
                </SelectorView>
                <SelectorView Key="RenderStates.Login">
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        <FloatingInput Type="text" Placeholder="@Strings.LOGIN_LABEL_ID" Value="@m_ID" Disabled="true" />
                        <FloatingInput @ref="m_InputPassword" Type="password" Placeholder="@Strings.LOGIN_LABEL_PW" @bind-Value="m_Password" Input="@OnChangedAsync" HasError="@PasswordError" />
                    </div>
                </SelectorView>
            </SelectorContainer>
            <div>
                @foreach (var error in GetErrorMessages())
                {
                    <p class="error-message">
                        <span class="material-symbols-outlined error-message">error</span>
                        <span class="error-message">@error</span>
                    </p>
                }
            </div>
            <div class="login-buttons-row">
                @if (m_RenderState is RenderStates.Id)
                {
                    <button type="button" onclick="@OnRegister">@Strings.LOGIN_BUTTON_REGISTER</button>
                }
                else
                {
                    <button type="button" onclick="@OnReturn">@Strings.LOGIN_BUTTON_RETURN</button>
                }
                <button type="submit" disabled="@(CanSubmit == false)">@Strings.LOGIN_BUTTON_CONTINUE</button>
            </div>
        </form>
    </div>
    <AsyncOperationProgress Display="@Requesting" />
</div>