@page "/manage-my-account"
@page "/"
@using OAuth2.Services
@using OAuth2.DTO
@using OAuth2
@layout AuthorizedLayout
@inject JwtAuthenticationStateProvider Auth
@inject IApiKeys ApiKeys
@inject IApiKeyCreationService ApiKeyCreation
@inject IOAuthGrants OAuthGrants
@inject IAccesses Accesses
@inject IJSRuntime JS

<div class="account-container">
    <div class="page-header">
        <div class="header-icon">
            <span class="material-symbols-outlined">manage_accounts</span>
        </div>
        <div class="header-text">
            <h2 class="page-title">@Strings.MANAGEACCOUNTS_PAGE_TITLE</h2>
            @if (Auth.Email != null)
            {
                <p class="page-subtitle">@Auth.Email</p>
            }
        </div>
    </div>

    <div class="info-section">
        <div class="section-header section-header-action">
            <span class="section-title">@Strings.MANAGEACCOUNTS_SECTION_PROFILE</span>
            <button type="button" class="section-action-btn" @onclick="OnEditProfileAsync" title="@Strings.MANAGEACCOUNTS_PROFILE_EDIT">
                <span class="material-symbols-outlined">edit</span>
                @Strings.MANAGEACCOUNTS_PROFILE_EDIT
            </button>
        </div>
        <div class="info-card">
            <div class="info-row picture-row-container">
                <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_PICTURE</div>
                <div class="info-value">
                    <div class="picture-action-row">
                        <img src="@Auth.Picture" alt="Profile picture" class="profile-img" />
                        <span class="link-button" @onclick="OnChangePictureAsync">
                            @Strings.MANAGEACCOUNTS_PICTURE_CHANGE
                        </span>
                    </div>
                </div>
            </div>
            @if (Auth.Name != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_NAME</div>
                    <div class="info-value">@Auth.Name</div>
                </div>
            }
            @if (Auth.GivenName != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_GIVEN_NAME</div>
                    <div class="info-value">@Auth.GivenName</div>
                </div>
            }
            @if (Auth.FamilyName != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_FAMILY_NAME</div>
                    <div class="info-value">@Auth.FamilyName</div>
                </div>
            }
            @if (Auth.Nickname != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_NICKNAME</div>
                    <div class="info-value">@Auth.Nickname</div>
                </div>
            }
            @if (Auth.PreferredUsername != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_PREFERRED_USERNAME</div>
                    <div class="info-value"><code class="code-value">@Auth.PreferredUsername</code></div>
                </div>
            }
            @if (Auth.Website != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_WEBSITE</div>
                    <div class="info-value">
                        @if (IsSafeUrl(Auth.Website))
                        {
                            <a href="@Auth.Website" target="_blank" rel="noopener noreferrer">@Auth.Website</a>
                        }
                        else
                        {
                            @Auth.Website
                        }
                    </div>
                </div>
            }
            @if (Auth.Gender != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_GENDER</div>
                    <div class="info-value">@Auth.Gender</div>
                </div>
            }
            @if (Auth.Birthdate != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_BIRTHDATE</div>
                    <div class="info-value">@Auth.Birthdate</div>
                </div>
            }
            @if (Auth.Locale != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_LOCALE</div>
                    <div class="info-value">@Auth.Locale</div>
                </div>
            }
            @if (Auth.ZoneInfo != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_ZONEINFO</div>
                    <div class="info-value">@Auth.ZoneInfo</div>
                </div>
            }
        </div>
    </div>

    <div class="info-section">
        <div class="section-header">
            <span class="section-title">@Strings.MANAGEACCOUNTS_SECTION_ACCOUNT</span>
        </div>
        <div class="info-card">
            <div class="info-row">
                <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_SUB</div>
                <div class="info-value"><code class="code-value">@Auth.Sub</code></div>
            </div>
            @if (Auth.Email != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_EMAIL</div>
                    <div class="info-value email-row">
                        <span>@Auth.Email</span>
                        @if (Auth.EmailVerified == true)
                        {
                            <span class="badge badge-verified">
                                <span class="material-symbols-outlined badge-icon">verified</span>
                                @Strings.MANAGEACCOUNTS_VALUE_EMAIL_VERIFIED
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-unverified">@Strings.MANAGEACCOUNTS_VALUE_EMAIL_NOT_VERIFIED</span>
                        }
                    </div>
                </div>
            }
            @if (Auth.UpdatedAt != null)
            {
                <div class="info-row">
                    <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_UPDATEDAT</div>
                    <div class="info-value">@FormatDateTime(Auth.UpdatedAt.Value)</div>
                </div>
            }
        </div>
    </div>

    <div class="info-section">
        <div class="section-header">
            <span class="section-title">@Strings.MANAGEACCOUNTS_SECTION_SECURITY</span>
        </div>
        <div class="info-card">
            <div class="info-row">
                <div class="info-label">@Strings.MANAGEACCOUNTS_HEAD_PASSWORD</div>
                <div class="info-value">
                    <span class="link-button" @onclick="OnChangePasswordAsync">
                        @Strings.MANAGEACCOUNTS_PASSWORD_CHANGE
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="info-section apikeys-section">
        <div class="section-header apikeys-section-header">
            <div class="section-header-text">
                <span class="section-title">@Strings.MANAGEACCOUNTS_SECTION_GRANTS</span>
                <span class="section-desc">@Strings.MANAGEACCOUNTS_GRANTS_SECTION_DESC</span>
            </div>
        </div>
        <div class="info-card apikeys-card">
            @if (m_OAuthGrants.Length == 0)
            {
                <div class="apikeys-empty">
                    <span class="material-symbols-outlined apikeys-empty-icon">link_off</span>
                    <span>@Strings.MANAGEACCOUNTS_GRANTS_EMPTY</span>
                </div>
            }
            else
            {
                <div class="grants-list">
                    @foreach (var grant in m_OAuthGrants)
                    {
                        var clientId = grant.ClientId;
                        <div class="grant-row">
                            <span class="material-symbols-outlined grant-icon">apps</span>
                            <div class="grant-meta">
                                <span class="grant-name">@grant.ClientName</span>
                                <span class="grant-detail">
                                    @Strings.MANAGEACCOUNTS_APIKEYS_CLIENT_LABEL: @grant.ClientId
                                    &nbsp;|&nbsp;
                                    @Strings.MANAGEACCOUNTS_GRANTS_GRANTED_AT: @grant.GrantedAt.ToString("yyyy-MM-dd HH:mm")
                                </span>
                                <span class="grant-scopes">
                                    @Strings.MANAGEACCOUNTS_GRANTS_SCOPE_LABEL:
                                    @foreach (var scope in grant.Scopes)
                                    {
                                        <code>@scope</code>
                                    }
                                </span>
                            </div>
                            <button @onclick="() => OnRevokeGrantAsync(clientId)" type="button" class="apikey-delete-btn" title="@Strings.MANAGEACCOUNTS_GRANTS_REVOKE">
                                <span class="material-symbols-outlined">link_off</span>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="info-section apikeys-section">
        <div class="section-header apikeys-section-header">
            <div class="section-header-text">
                <span class="section-title">@Strings.MANAGEACCOUNTS_SECTION_APIKEYS</span>
                <span class="section-desc">@Strings.MANAGEACCOUNTS_APIKEYS_SECTION_DESC</span>
            </div>
        </div>
        <div class="info-card apikeys-card">
            @if (m_ApiKeys.Length == 0)
            {
                <div class="apikeys-empty">
                    <span class="material-symbols-outlined apikeys-empty-icon">vpn_key_off</span>
                    <span>@Strings.MANAGE_APPLICATION_APIKEYS_EMPTY</span>
                </div>
            }
            else
            {
                <div class="apikeys-list">
                    @foreach (var apiKey in m_ApiKeys)
                    {
                        var apiKeyId = apiKey.Id;
                        <div class="apikey-row">
                            <span class="material-symbols-outlined apikey-icon">vpn_key</span>
                            <div class="apikey-meta">
                                <span class="apikey-name">@apiKey.Name</span>
                                <span class="apikey-detail">
                                    @Strings.MANAGEACCOUNTS_APIKEYS_CLIENT_LABEL: @(string.IsNullOrEmpty(apiKey.AllowedClientId) ? Strings.MANAGEACCOUNTS_APIKEYS_ALL_CLIENTS : apiKey.AllowedClientId)
                                    &nbsp;|&nbsp;
                                    @Strings.MANAGEACCOUNTS_APIKEYS_SCOPE_LABEL: @(string.IsNullOrEmpty(apiKey.AllowedScope) ? Strings.MANAGEACCOUNTS_APIKEYS_ALL_SCOPES : apiKey.AllowedScope)
                                    &nbsp;|&nbsp;
                                    @Strings.MANAGE_APPLICATION_APIKEYS_CREATED_AT: @apiKey.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                </span>
                            </div>
                            <button @onclick="() => OnRemoveApiKeyAsync(apiKeyId)" type="button" class="apikey-delete-btn" title="@Strings.MANAGE_APPLICATION_APIKEYS_REMOVE">
                                <span class="material-symbols-outlined">delete</span>
                            </button>
                        </div>
                    }
                </div>
            }
            <div class="add-apikey-panel">
                <div class="add-apikey-inputs">
                    <FloatingInput @bind-Value="m_NewApiKeyName" Type="text" Placeholder="@Strings.MANAGE_APPLICATION_APIKEYS_NAME_PLACEHOLDER" />
                    <FloatingInput @bind-Value="m_NewApiKeyAllowedClientId" Type="text" Placeholder="@Strings.MANAGEACCOUNTS_APIKEYS_CLIENT_PLACEHOLDER" />
                    <FloatingInput @bind-Value="m_NewApiKeyAllowedScope" Type="text" Placeholder="@Strings.MANAGEACCOUNTS_APIKEYS_SCOPE_PLACEHOLDER" />
                </div>
                <button @onclick="OnAddApiKeyAsync" type="button" class="apikey-add-btn" disabled="@(!CanAddApiKey)">
                    <span class="material-symbols-outlined">add</span>
                    @Strings.MANAGE_APPLICATION_APIKEYS_NEW_BUTTON
                </button>
            </div>
        </div>
    </div>
</div>

<DlgChangePassword @ref="m_DlgChangePassword" />
<DlgChangePicture @ref="m_DlgChangePicture" />
<DlgEditProfile @ref="m_DlgEditProfile" />
<DlgNewApiKey @ref="m_DlgNewApiKey" OnClose="OnNewApiKeyDialogClosedAsync" />

@code {
    private DlgChangePassword m_DlgChangePassword = null!;
    private DlgChangePicture m_DlgChangePicture = null!;
    private DlgEditProfile m_DlgEditProfile = null!;
    private DlgNewApiKey m_DlgNewApiKey = null!;

    private ApiKeyInfo[] m_ApiKeys = [];
    private OAuthGrantInfo[] m_OAuthGrants = [];
    private string? m_NewApiKeyName;
    private string? m_NewApiKeyAllowedClientId;
    private string? m_NewApiKeyAllowedScope;

    private bool CanAddApiKey =>
        !string.IsNullOrWhiteSpace(m_NewApiKeyName) &&
        !string.IsNullOrWhiteSpace(m_NewApiKeyAllowedClientId) &&
        !string.IsNullOrWhiteSpace(m_NewApiKeyAllowedScope);

    protected override async Task OnInitializedAsync()
    {
        await RefreshApiKeysAsync();
        await RefreshOAuthGrantsAsync();
    }

    private async Task RefreshApiKeysAsync()
    {
        var accountId = Auth.Id;
        if (!string.IsNullOrEmpty(accountId))
        {
            m_ApiKeys = await ApiKeys.GetApiKeysAsync(accountId);
        }
    }

    private async Task RefreshOAuthGrantsAsync()
    {
        var accountId = Auth.Id;
        if (!string.IsNullOrEmpty(accountId))
        {
            m_OAuthGrants = await OAuthGrants.GetGrantedClientsAsync(accountId);
        }
    }

    private async Task OnAddApiKeyAsync()
    {
        if (!CanAddApiKey)
        {
            return;
        }

        var accountId = Auth.Id;
        if (string.IsNullOrEmpty(accountId))
        {
            return;
        }

        var apiKeyName = m_NewApiKeyName!.Trim();
        var allowedClientId = m_NewApiKeyAllowedClientId!.Trim();
        var allowedScope = m_NewApiKeyAllowedScope!.Trim();
        var result = await ApiKeyCreation.CreateApiKeyAsync(accountId, apiKeyName, allowedClientId, allowedScope);
        if (!result.IsSuccess || result.ApiKey == null)
        {
            return;
        }

        m_NewApiKeyName = null;
        m_NewApiKeyAllowedClientId = null;
        m_NewApiKeyAllowedScope = null;
        await RefreshApiKeysAsync();
        await m_DlgNewApiKey.ShowAsync(result.ApiKey);
    }

    private async Task OnNewApiKeyDialogClosedAsync()
    {
        await RefreshApiKeysAsync();
        StateHasChanged();
    }

    private async Task OnRemoveApiKeyAsync(long apiKeyId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", Strings.MANAGE_APPLICATION_APIKEYS_REMOVE_CONFIRM);
        if (!confirmed)
        {
            return;
        }

        await ApiKeys.RemoveApiKeyAsync(apiKeyId);
        await RefreshApiKeysAsync();
    }

    private async Task OnRevokeGrantAsync(string clientId)
    {
        var grant = m_OAuthGrants.FirstOrDefault(value => value.ClientId == clientId);
        var clientName = string.IsNullOrEmpty(grant.ClientName) ? clientId : grant.ClientName;
        var confirmed = await JS.InvokeAsync<bool>("confirm", string.Format(Strings.MANAGEACCOUNTS_GRANTS_REVOKE_CONFIRM, clientName));
        if (!confirmed)
        {
            return;
        }

        var accountId = Auth.Id;
        var sub = Auth.Sub;
        if (string.IsNullOrEmpty(accountId) || string.IsNullOrEmpty(sub))
        {
            return;
        }

        await Accesses.InvalidateClientTokensAsync(sub, clientId);
        await OAuthGrants.RevokeClientGrantsAsync(accountId, clientId);
        await RefreshOAuthGrantsAsync();
    }

    private async Task OnChangePasswordAsync()
    {
        await m_DlgChangePassword.ShowAsync();
    }

    private async Task OnChangePictureAsync()
    {
        await m_DlgChangePicture.ShowAsync();
    }

    private async Task OnEditProfileAsync()
    {
        await m_DlgEditProfile.ShowAsync();
    }

    private static bool IsSafeUrl(string url)
    {
        return Uri.TryCreate(url, UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }

    private string FormatDateTime(DateTimeOffset value)
    {
        var local = value.ToLocalTime();
        if (!string.IsNullOrEmpty(Auth.Locale) &&
            System.Globalization.CultureInfo.GetCultureInfo(Auth.Locale) is { } culture)
        {
            return local.ToString("G", culture);
        }
        return local.ToString("G", System.Globalization.CultureInfo.CurrentCulture);
    }
}
