@using OAuth2.Services
@using OAuth2.Utility
@using OAuth2
@layout AuthorizedLayout
@inject IClients Clients
@inject IClientClaims ClientClaims
@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="manage-container">
    <div class="breadcrumb">
        <button class="back-button" @onclick="OnBackAsync">
            <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <span class="breadcrumb-separator">
            <span class="material-symbols-outlined">chevron_right</span>
        </span>
        <span class="breadcrumb-current">@(ViewType == ManageApplications.ViewTypes.New ? Strings.NEWCLIENT_TITLE : (m_Name ?? Strings.MANAGECLIENT_TITLE))</span>
    </div>

    <div class="manage-header">
        <div class="manage-header-icon">
            <span class="material-symbols-outlined">app_registration</span>
        </div>
        <div class="manage-header-text">
            <h2 class="manage-title">@(ViewType == ManageApplications.ViewTypes.New ? Strings.NEWCLIENT_TITLE : Strings.MANAGECLIENT_TITLE)</h2>
            @if (ViewType != ManageApplications.ViewTypes.New && m_Id != null)
            {
                <span class="manage-subtitle">@Strings.CLIENTS_CLIENT_SUB_LABEL: <code>@m_Id</code></span>
            }
        </div>
    </div>

    <div class="manage-content">
        <ClientForm @bind-Name="m_Name"
                    Id="@m_Id"
                    NewClientId="@m_NewClientId"
                    NewClientIdChanged="@OnNewClientIdChanged"
                    NewClientIdErrorMessage="@m_NewClientIdErrorMessage"
                    IsNewMode="@(ViewType == ManageApplications.ViewTypes.New)"
                    IsSubmitting="@m_IsSubmitting"
                    OnSubmit="@OnContinueAsync" />
    </div>
</div>

<DlgNewClientSecret @ref="m_DlgNewSecret" OnClose="OnNewSecretDialogClosedAsync" />

@code {
    private IJSObjectReference? m_Module;
    private string? m_Name;
    private string? m_Id;
    private string? m_NewClientId;
    private string? m_NewClientIdErrorMessage;
    private bool m_IsSubmitting = false;
    private DlgNewClientSecret m_DlgNewSecret = null!;
    private string? m_PendingNavigate;

    [Parameter]
    public ManageApplications.ViewTypes ViewType { get; set; }

    [Parameter]
    public string? ClientId { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            m_Module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Applications/ManageApplication.razor.js");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(ClientId) == false)
        {
            var sub = Auth.Sub;
            var client = await Clients.GetClientAsync(ClientId);
            // Security: verify the client belongs to the authenticated user
            if (client.HasValue && client.Value.OwnerId == sub)
            {
                m_Name = client.Value.Name;
                m_Id = client.Value.Id;
            }
            else
            {
                // Client not found or does not belong to the current user
                Nav.NavigateTo("/manage-applications");
            }
        }
        else
        {
            m_Name = null;
            m_Id = null;
            m_NewClientId = null;
            m_NewClientIdErrorMessage = null;
        }
    }

    private async Task OnContinueAsync()
    {
        if (m_IsSubmitting)
        {
            return;
        }

        if (string.IsNullOrEmpty(m_Name) || string.IsNullOrEmpty(Auth.Sub))
        {
            Nav.NavigateTo("/error");
            return;
        }

        if (!ClientIdPolicy.TryNormalize(m_NewClientId, out var normalizedClientId, out var validationError))
        {
            m_NewClientIdErrorMessage = GetClientIdValidationMessage(validationError);
            StateHasChanged();
            return;
        }

        m_IsSubmitting = true;
        StateHasChanged();

        try
        {
            var clientId = await Clients.AddClientAsync(normalizedClientId, m_Name, Auth.Sub, []);
            var secret = await Clients.NewClientSecretAsync(clientId);

            // Show the secret dialog before navigating away so the user can copy it
            m_PendingNavigate = "/manage-applications";
            await m_DlgNewSecret.ShowAsync(secret);
        }
        catch
        {
            m_IsSubmitting = false;
            StateHasChanged();
            throw;
        }
    }

    private Task OnNewClientIdChanged(string? value)
    {
        m_NewClientId = value;
        m_NewClientIdErrorMessage = null;
        return Task.CompletedTask;
    }

    private static string GetClientIdValidationMessage(ClientIdValidationError error)
    {
        return error switch
        {
            ClientIdValidationError.Required => Strings.NEWCLIENT_VALIDATION_ERROR_CLIENT_ID_REQUIRED,
            ClientIdValidationError.TooLong => string.Format(Strings.NEWCLIENT_VALIDATION_ERROR_CLIENT_ID_TOO_LONG, ClientIdPolicy.MaxLength),
            ClientIdValidationError.InvalidCharacter => Strings.NEWCLIENT_VALIDATION_ERROR_CLIENT_ID_INVALID,
            _ => Strings.ERRORS_INVALID_CLIENT_ID
        };
    }

    private Task OnNewSecretDialogClosedAsync()
    {
        if (m_PendingNavigate != null)
        {
            var url = m_PendingNavigate;
            m_PendingNavigate = null;
            Nav.NavigateTo(url, forceLoad: false);
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (m_Module != null)
        {
            try
            {
                await m_Module.DisposeAsync();
            }
            catch (Exception e) when (e is ObjectDisposedException || e is JSDisconnectedException)
            {
            }
        }
    }

    private Task OnBackAsync()
    {
        Nav.NavigateTo("/manage-applications");
        return Task.CompletedTask;
    }
}
