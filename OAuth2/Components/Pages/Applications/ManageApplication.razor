@using OAuth2.Services
@using OAuth2.Utility
@layout AuthorizedLayout
@inject IClients Clients
@inject IClientClaims ClientClaims
@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="container">
    <h4>@(ViewType == ManageApplications.ViewTypes.New ? Strings.NEWCLIENT_TITLE : Strings.MANAGECLIENT_TITLE)</h4>
    <div class="inner">
        <ClientForm Name="@m_Name" 
                    NameChanged="@((value) => m_Name = value)"
                    IsNewMode="@(ViewType == ManageApplications.ViewTypes.New)"
                    IsSubmitting="@m_IsSubmitting"
                    OnSubmit="@OnContinueAsync" />
    </div>
</div>

@code {
    private IJSObjectReference? m_Module;
    private string? m_Name;
    private string[] m_Secrets = [];
    private bool m_IsSubmitting = false;

    [Parameter]
    public ManageApplications.ViewTypes ViewType { get; set; }

    [Parameter]
    public string? ClientId { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            m_Module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Applications/ManageApplication.razor.js");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(ClientId) == false)
        {
            var client = await Clients.GetClientAsync(ClientId);
            if (client.HasValue)
            {
                m_Name = client.Value.Name;
            }
        }
        else
        {
            m_Name = null;
        }
    }

    private async Task OnContinueAsync()
    {
        if (m_IsSubmitting)
        {
            return;
        }

        if (string.IsNullOrEmpty(m_Name) || string.IsNullOrEmpty(Auth.Sub))
        {
            Nav.NavigateTo("/error");
            return;
        }

        m_IsSubmitting = true;
        StateHasChanged();

        try
        {
            var clientId = await Clients.AddClientAsync(m_Name, Auth.Sub, []);
            var secret = await Clients.NewClientSecretAsync(clientId);
            
            // 등록 완료 후 목록 페이지로 돌아가기
            Nav.NavigateTo("/manage-applications", forceLoad: false);
        }
        catch
        {
            m_IsSubmitting = false;
            StateHasChanged();
            throw;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (m_Module != null)
        {
            try
            {
                await m_Module.DisposeAsync();
            }
            catch (Exception e) when (e is ObjectDisposedException || e is JSDisconnectedException)
            {
            }
        }
    }
}