@using OAuth2.DTO
@using OAuth2.Localizations
@using OAuth2.Services
@using OAuth2.Utility
@inject IClients Clients
@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-container">
    <div class="page-header">
        <div class="page-header-text">
            <h2 class="page-title">@Strings.NAVMENU_LABEL_MANAGE_APPLICATIONS</h2>
            <p class="page-subtitle">@Strings.MANAGE_APPLICATIONS_SUBTITLE</p>
        </div>
        <button class="btn-primary" @onclick="OnAddButtonClickedAsync">
            <span class="material-symbols-outlined btn-icon">add</span>
            @Strings.NEWCLIENT_BUTTONS_NEW
        </button>
    </div>

    <div class="clients-card">
        @if (m_Clients.Length == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined empty-icon">apps</span>
                <p class="empty-title">@Strings.MANAGE_APPLICATIONS_EMPTY_TITLE</p>
                <p class="empty-subtitle">@Strings.MANAGE_APPLICATIONS_EMPTY_SUBTITLE</p>
            </div>
        }
        else
        {
            <div class="clients-table-header">
                <span class="col-name">@Strings.CLIENTS_CLIENT_NAME_LABEL</span>
                <span class="col-type">@Strings.CLIENTS_CLIENT_TYPE_LABEL</span>
                <span class="col-id">@Strings.CLIENTS_CLIENT_SUB_LABEL</span>
            </div>
            <div class="clients-table-body">
                @foreach (var client in m_Clients)
                {
                    <div class="client-row" @onclick="() => OnManageClientAsync(client.Id)">
                        <div class="col-name">
                            <div class="app-icon">
                                <span class="material-symbols-outlined">web</span>
                            </div>
                            <span class="app-name">@client.Name</span>
                        </div>
                        <div class="col-type">
                            <span class="type-badge">@Strings.CLIENTS_CLIENT_TYPE_WEB_APPLICATION</span>
                        </div>
                        <div class="col-id">
                            <span class="client-id-text" title="@client.Id">@client.Id</span>
                        </div>
                        <div class="col-action">
                            <button @onclick:stopPropagation="true" @onclick="() => OnDeleteClientAsync(client.Id)" class="btn-delete-client" title="@Strings.MANAGE_APPLICATION_DELETE_BUTTON">
                                <span class="material-symbols-outlined">delete</span>
                            </button>
                            <span class="material-symbols-outlined arrow-icon">chevron_right</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private ClientInfo[] m_Clients = [];

    [Parameter]
    public ManageApplications? Owner { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var sub = Auth.Sub;
        if (sub == null)
        {
            Nav.NavigateTo("/error");
            return;
        }

        m_Clients = await Clients.GetClientsAsync(sub);
        StateHasChanged();
    }

    private Task OnAddButtonClickedAsync()
    {
        Nav.NavigateWithQuery(("view_type", "new"));
        return Task.CompletedTask;
    }

    private Task OnManageClientAsync(string id)
    {
        Nav.NavigateWithQuery(("view_type", "modify"), ("id", id));
        return Task.CompletedTask;
    }

    private async Task OnDeleteClientAsync(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", Strings.MANAGE_APPLICATION_DELETE_CONFIRM);
        if (!confirmed)
        {
            return;
        }

        await Clients.RemoveClientAsync(id);

        var sub = Auth.Sub;
        if (sub == null)
        {
            Nav.NavigateTo("/error");
            return;
        }

        m_Clients = await Clients.GetClientsAsync(sub);
        StateHasChanged();
    }
}