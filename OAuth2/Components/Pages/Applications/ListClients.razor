@using OAuth2.DTO
@using OAuth2.Services
@using OAuth2.Utility
@inject IClients Clients
@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Nav

<div class="container">
    <button class="link-button" @onclick="OnAddButtonClickedAsync">@Strings.NEWCLIENT_BUTTONS_NEW</button>
    <div class="clients-list">
        <div class="client-item">
            <table>
                <thead>
                    <tr>
                        <th>
                            @Strings.CLIENTS_CLIENT_NAME_LABEL
                        </th>
                        <th>
                            @Strings.CLIENTS_CLIENT_TYPE_LABEL
                        </th>
                        <th>
                            @Strings.CLIENTS_CLIENT_SUB_LABEL
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in m_Clients)
                    {
                        <tr>
                            <td>
                                <span class="link-button" @onclick="() => OnManageClientAsync(client.Id)">
                                    @client.Name
                                </span>
                            </td>
                            <td>
                                @Strings.CLIENTS_CLIENT_TYPE_WEB_APPLICATION
                            </td>
                            <td>
                                @client.Id
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private ClientInfo[] m_Clients = [];

    [Parameter]
    public ManageApplications? Owner { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var sub = Auth.Sub;
        if (sub == null)
        {
            Nav.NavigateTo("/error");
            return;
        }

        m_Clients = await Clients.GetClientsAsync(sub);
        StateHasChanged();
    }

    private Task OnAddButtonClickedAsync()
    {
        Nav.NavigateWithQuery(("view_type", "new"));
        return Task.CompletedTask;
    }

    private Task OnManageClientAsync(string id)
    {
        Nav.NavigateWithQuery(("view_type", "modify"), ("id", id));
        return Task.CompletedTask;
    }
}