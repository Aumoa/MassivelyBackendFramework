@page "/error"
@layout NotAuthorizedLayout
@inject NavigationManager Nav

<ErrorView ErrorTextBody="@Strings.ERRORS_TEXT_BODY" ErrorText="@ErrorText" ReturnToMainText="@ReturnToMainText" ReturnClicked="@ReturnMain" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorText { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "return_main")]
    public bool ShowReturnMain { get; set; }

    public string ReturnToMainText => ShowReturnMain ? Strings.ERRORS_BUTTON_RETURN_TO_MAIN : string.Empty;

    private void ReturnMain()
    {
        Nav.NavigateTo("/", forceLoad: true);
    }
}