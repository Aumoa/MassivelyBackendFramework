@page "/auth/logout"
@using OAuth2.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@inject IAccesses Accesses

@if (IsInitialized)
{
    <RedirectToLogin />
}

@code {
    private bool IsInitialized { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext == null)
        {
            throw new InvalidOperationException();
        }

        var accessToken = httpContext.Request.Cookies["access_token"];

        var cookieOptions = new CookieOptions
        {
            HttpOnly = true,
            Secure = true,
            SameSite = SameSiteMode.Strict
        };

        httpContext.Response.Cookies.Delete("id_token", cookieOptions);
        httpContext.Response.Cookies.Delete("access_token", cookieOptions);
        httpContext.Response.Cookies.Delete("refresh_token", cookieOptions);
        httpContext.Response.Cookies.Delete("id", cookieOptions);
        httpContext.Response.Cookies.Delete("op_session", new CookieOptions
        {
            HttpOnly = true,
            Secure = true,
            SameSite = SameSiteMode.Lax,
            Path = "/"
        });

        foreach (var cookie in httpContext.Request.Cookies)
        {
            if (!cookie.Key.StartsWith("cached_jwt_", StringComparison.Ordinal))
            {
                continue;
            }

            httpContext.Response.Cookies.Delete(cookie.Key, new CookieOptions
            {
                HttpOnly = true,
                Secure = true,
                SameSite = SameSiteMode.Lax,
                Path = "/"
            });
            httpContext.Response.Cookies.Delete(cookie.Key, new CookieOptions
            {
                HttpOnly = true,
                Secure = true,
                SameSite = SameSiteMode.Lax,
                Path = "/authorize"
            });
        }

        if (!string.IsNullOrEmpty(accessToken))
        {
            try
            {
                await Accesses.RevokeAsync(accessToken);
            }
            catch
            {
                // Server-side revocation is best-effort; local cookie cleanup already completed.
            }
        }

        IsInitialized = true;
    }
}
