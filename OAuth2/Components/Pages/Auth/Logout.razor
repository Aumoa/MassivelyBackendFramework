@page "/auth/logout"
@using OAuth2.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@inject IAccesses Accesses

@if (IsInitialized)
{
    <RedirectToLogin />
}

@code {
    private bool IsInitialized { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext == null)
        {
            throw new InvalidOperationException();
        }

        var accessToken = httpContext.Request.Cookies["access_token"];

        var cookieOptions = new CookieOptions
        {
            HttpOnly = true,
            Secure = true,
            SameSite = SameSiteMode.Strict
        };

        httpContext.Response.Cookies.Delete("id_token", cookieOptions);
        httpContext.Response.Cookies.Delete("access_token", cookieOptions);
        httpContext.Response.Cookies.Delete("refresh_token", cookieOptions);
        httpContext.Response.Cookies.Delete("id", cookieOptions);

        if (!string.IsNullOrEmpty(accessToken))
        {
            try
            {
                await Accesses.RevokeAsync(accessToken);
            }
            catch
            {
                // Server-side revocation is best-effort; local cookie cleanup already completed.
            }
        }

        IsInitialized = true;
    }
}