@page "/register"
@layout AuthorizeLayout

<div class="login-form">
    <div class="login-form-content">
        <h2 class="title">
            @Strings.REGISTER_FORM_TITLE
        </h2>
        <form class="input-form" @onsubmit="OnContinueAsync">
            <div class="login-fields">
                <FloatingInput Type="text" Placeholder="@Strings.LOGIN_LABEL_ID" @bind-Value="m_ID" Input="@OnChangedAsync" HasError="@IdError" />
                <FloatingInput Type="password" Placeholder="@Strings.LOGIN_LABEL_PW" @bind-Value="m_Password" Input="@OnChangedAsync" HasError="@PasswordError" />
                <FloatingInput Type="text" Placeholder="@Strings.LOGIN_LABEL_EMAIL" @bind-Value="m_Email" Input="@OnChangedAsync" HasError="@EmailError" />
                <FloatingInput Type="text" Placeholder="@Strings.LOGIN_LABEL_NAME" @bind-Value="m_Name" Input="@OnChangedAsync" HasError="@NameError" />
            </div>
            <div>
                @foreach (var error in GetErrorMessages())
                {
                    <p class="error-message">
                        <span class="material-symbols-outlined error-message">error</span>
                        <span class="error-message">@error</span>
                    </p>
                }
            </div>
            <div class="login-buttons-row">
                <button type="submit" disabled="@(CanSubmit == false)">@Strings.LOGIN_BUTTON_CONTINUE</button>
            </div>
        </form>
    </div>
    <AsyncOperationProgress Display="@Requesting" />
</div>
