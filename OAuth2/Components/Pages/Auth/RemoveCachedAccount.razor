@page "/authorize/remove-cached-account"
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@layout AuthorizeLayout

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "id")]
    public string Id { get; set; } = null!;

    [Parameter]
    [SupplyParameterFromQuery(Name = "return_url")]
    public string ReturnUrl { get; set; } = null!;

    protected override void OnParametersSet()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null && !string.IsNullOrEmpty(Id) && !httpContext.Response.HasStarted)
        {
            httpContext.Response.Cookies.Delete($"cached_jwt_{Id}", new CookieOptions
            {
                HttpOnly = true,
                Secure = true,
                SameSite = SameSiteMode.Lax
            });
        }

        // Only allow relative URLs that are well-formed to prevent open-redirect attacks.
        var destination = !string.IsNullOrEmpty(ReturnUrl)
            && ReturnUrl.StartsWith('/')
            && !ReturnUrl.StartsWith("//")
            && !ReturnUrl.StartsWith("/\\")
            && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
            ? ReturnUrl
            : "/";
        Nav.NavigateTo(destination, forceLoad: true);
    }
}
