@page "/authorize/int"
@using Microsoft.Extensions.Options
@using OAuth2.Services
@using OAuth2.Options
@using System.Security.Claims
@inject IAccesses Accesses
@inject IAuthorizationCodes AuthorizationCodes
@inject NavigationManager Nav
@inject IJwt Jwt
@inject IAccounts Accounts
@inject IAccountClaims AccountClaims
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Int> Logger
@inject IOptions<HostOptions> HostOptions
@layout AuthorizeLayout

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "redirect_uri")]
    public string RedirectUri { get; set; } = null!;

    [Parameter]
    [SupplyParameterFromQuery(Name = "code")]
    public string Code { get; set; } = null!;

    protected override async Task OnParametersSetAsync()
    {
        var code = await AuthorizationCodes.PopAsync(Code);
        if (code.HasValue == false)
        {
            Error(Strings.ERRORS_INVALID_ACCESS);
            return;
        }

        // Validate the redirect_uri to prevent open redirect attacks.
        // Only allow http/https URIs or relative paths on the same origin.
        if (!IsValidRedirectUri(RedirectUri))
        {
            Error(Strings.ERRORS_INVALID_REDIRECT_URI);
            return;
        }

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            try
            {
                var rawAccount = await Accounts.GetRawAccountAsync(code.Value.AccountId);
                var access = await Accesses.WriteAccessAsync(code.Value.AccountId, rawAccount.Value.Sub, code.Value.Scope, code.Value.ClientId, Jwt.ExpiresIn, Jwt.RefreshTokenExpiresIn);
                var claims = await AccountClaims.GetClaimsAsync(code.Value.AccountId);
                var jwt = Jwt.Issue(HostOptions.Value.ClientId, [
                    new("access_token", access.AccessToken),
                    new("refresh_token", access.RefreshToken),
                    new("id", code.Value.AccountId),
                    .. Jwt.ConfigureClaims(rawAccount.Value, code.Value.Scope, claims, null, true)
                ]);

                httpContext.Response.Cookies.Append($"cached_jwt_{code.Value.AccountId}", jwt, new CookieOptions
                {
                    HttpOnly = true,
                    Secure = true,
                    SameSite = SameSiteMode.Lax,
                    Expires = DateTimeOffset.UtcNow.AddYears(10)
                });
            }
            catch (Exception e)
            {
                Logger.LogWarning("Failed to cache access token: {Message}", e.Message);
            }
        }

        Nav.NavigateTo(RedirectUri, forceLoad: true);
        return;

        void Error(string message)
        {
            Nav.NavigateTo($"/error?error={Uri.EscapeDataString(message)}");
        }
    }

    private static bool IsValidRedirectUri(string uri)
    {
        if (string.IsNullOrWhiteSpace(uri))
        {
            return false;
        }

        // Allow safe relative paths on the same origin (must start with '/' and not '//')
        if (uri.StartsWith('/') && !uri.StartsWith("//"))
        {
            // Validate as a relative URI to block encoded slashes or other bypass attempts
            return Uri.TryCreate(uri, UriKind.Relative, out _);
        }

        // Allow only http and https absolute URIs
        if (Uri.TryCreate(uri, UriKind.Absolute, out var parsedUri))
        {
            return parsedUri.Scheme == Uri.UriSchemeHttp || parsedUri.Scheme == Uri.UriSchemeHttps;
        }

        return false;
    }
}