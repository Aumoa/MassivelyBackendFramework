@page "/manage-roles"
@using OAuth2.Localizations
@using OAuth2.Services
@using OAuth2.DTO
@layout AuthorizedLayout
@inject IAccountRoles Roles
@inject IAccounts Accounts
@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Nav

<div class="manage-container">
    <div class="manage-header">
        <div class="manage-header-icon">
            <span class="material-symbols-outlined">shield_person</span>
        </div>
        <div class="manage-header-text">
            <h2 class="manage-title">@Strings.MANAGE_ROLES_TITLE</h2>
        </div>
    </div>

    @if (m_IsAuthorized)
    {
        <div class="manage-content">
            <div class="form-wrapper">
                <div class="form-section">
                    <div class="section-header">
                        <div class="section-header-text">
                            <h3 class="section-title">@Strings.MANAGE_ROLES_SECTION</h3>
                            <p class="section-desc">@Strings.MANAGE_ROLES_SECTION_DESC</p>
                        </div>
                    </div>
                    <div class="section-body">
                        @foreach (var accountRoles in m_Roles.GroupBy(r => r.AccountId))
                        {
                            var firstItem = accountRoles.First();
                            <div class="user-group-block">
                                <div class="user-group-account">
                                    <span class="material-symbols-outlined user-icon">person</span>
                                    <span class="user-account-id">@firstItem.AccountLoginId</span>
                                    <span class="user-account-sub">@firstItem.AccountId</span>
                                </div>
                                @foreach (var role in accountRoles)
                                {
                                    var roleId = role.Id;
                                    var index = Array.IndexOf(m_Roles, role);
                                    <div class="uri-row">
                                        <div class="uri-input-wrap">
                                            <FloatingInput Type="text" Placeholder="Role name" Value="@m_Roles[index].Name" ValueChanged="@(value => UpdateRole(index, value))" />
                                        </div>
                                        <button type="button" class="btn-icon-action btn-save" disabled="@(!m_Roles[index].IsChanged)" @onclick="() => ApplyRoleAsync(index)" title="@Strings.CLIENTFORM_BUTTON_APPLY">
                                            <span class="material-symbols-outlined">save</span>
                                        </button>
                                        <button type="button" class="btn-icon-action btn-delete" @onclick="() => DeleteRoleAsync(index)" title="@Strings.CLIENTFORM_BUTTON_REMOVE">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        <div class="add-user-group-panel">
                            <div class="add-user-group-inputs">
                                <FloatingInput @bind-Value="m_NewUserIdentifier" HasError="@m_HasNewUserError" Type="text" Placeholder="User ID / Email / Sub" />
                                <FloatingInput @bind-Value="m_NewRoleName" Type="text" Placeholder="Role name" />
                            </div>
                            @if (!string.IsNullOrEmpty(m_NewUserErrorMessage))
                            {
                                <div class="add-user-group-error">
                                    <span class="material-symbols-outlined add-user-group-error-icon">error</span>
                                    <span>@m_NewUserErrorMessage</span>
                                </div>
                            }
                            <button @onclick="AddRoleAsync" type="button" class="btn-text-add">
                                <span class="material-symbols-outlined">person_add</span>
                                @Strings.CLIENTFORM_BUTTON_ADD
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    public struct RoleItem
    {
        public long Id { get; set; }
        public string AccountId { get; set; }
        public string AccountLoginId { get; set; }
        public string OriginName { get; set; }
        public string Name { get; set; }

        public readonly bool IsChanged => OriginName != Name;
    }

    private bool m_IsAuthorized;
    private RoleItem[] m_Roles = [];
    private string? m_NewUserIdentifier;
    private string? m_NewRoleName;
    private bool m_HasNewUserError;
    private string? m_NewUserErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        var sub = Auth.Sub;
        if (string.IsNullOrEmpty(sub) || !await Roles.HasRoleAsync(sub, "admin"))
        {
            Nav.NavigateTo("/manage-applications");
            return;
        }

        m_IsAuthorized = true;
        await RefreshRolesAsync();
    }

    public async Task AddRoleAsync()
    {
        m_HasNewUserError = false;
        m_NewUserErrorMessage = null;

        if (string.IsNullOrWhiteSpace(m_NewUserIdentifier) || string.IsNullOrWhiteSpace(m_NewRoleName))
        {
            return;
        }

        var sub = await Accounts.ResolveSubAsync(m_NewUserIdentifier.Trim());
        if (sub == null)
        {
            m_HasNewUserError = true;
            m_NewUserErrorMessage = Strings.CLIENTFORM_ERROR_USER_NOT_FOUND;
            return;
        }

        await Roles.AddAccountRoleAsync(sub, m_NewRoleName.Trim());
        m_NewUserIdentifier = null;
        m_NewRoleName = null;
        await RefreshRolesAsync();
    }

    private void UpdateRole(int index, string value)
    {
        if (index >= 0 && index < m_Roles.Length)
        {
            m_Roles[index].Name = value;
        }
    }

    private async Task ApplyRoleAsync(int index)
    {
        if (index < 0 || index >= m_Roles.Length)
        {
            return;
        }

        ref var role = ref m_Roles[index];
        if (!role.IsChanged)
        {
            return;
        }

        await Roles.ModifyAccountRoleAsync(role.Id, role.Name);
        await RefreshRolesAsync();
    }

    public async Task DeleteRoleAsync(int index)
    {
        if (index < 0 || index >= m_Roles.Length)
        {
            return;
        }

        ref var role = ref m_Roles[index];
        await Roles.RemoveAccountRoleAsync(role.Id);
        await RefreshRolesAsync();
    }

    private async ValueTask RefreshRolesAsync()
    {
        var roles = await Roles.GetAllAccountRolesAsync();
        m_Roles = [.. roles.Select(r => new RoleItem
            {
                Id = r.Id,
                AccountId = r.AccountId,
                AccountLoginId = r.AccountLoginId,
                OriginName = r.Name,
                Name = r.Name
            })];
    }
}
