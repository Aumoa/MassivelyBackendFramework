@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>AI Chat</PageTitle>

<div class="chat-page">
    <div class="messages-area" id="messages-area">
        <div class="messages-inner">
            <div class="welcome-message">
                <span class="material-symbols-outlined welcome-icon">smart_toy</span>
                <h2>무엇을 도와드릴까요?</h2>
                <p>Ollama에 연결된 AI와 대화를 시작하세요.</p>
            </div>
        </div>
    </div>

    <div class="input-area">
        <div class="input-wrapper">
            <textarea @ref="m_TextareaRef"
                      @bind="m_InputText"
                      @bind:event="oninput"
                      @onkeydown="OnInputKeyDown"
                      class="chat-input"
                      placeholder="메시지를 입력하세요..."
                      rows="1"></textarea>
            <button @onclick="OnSendClick"
                    class="send-btn"
                    disabled="@string.IsNullOrWhiteSpace(m_InputText)"
                    title="전송">
                <span class="material-symbols-outlined">send</span>
            </button>
        </div>
        <p class="input-hint">AI가 실수를 할 수 있으니 중요한 정보는 직접 확인하세요.</p>
    </div>
</div>

@code {
    private string m_InputText = string.Empty;
    private ElementReference m_TextareaRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("attachChatInput", m_TextareaRef);
        }
    }

    private void OnSendClick()
    {
        var text = m_InputText.Trim();
        if (string.IsNullOrWhiteSpace(text))
            return;

        // TODO: send message to Ollama
        m_InputText = string.Empty;
    }

    private void OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            OnSendClick();
        }
    }
}
