@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IAIMessenger AIMessenger
@inject IChatRepository ChatRepository
@inject ChatStateService ChatState
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable
@using Markdig

<PageTitle>@Strings.CHAT_PAGE_TITLE</PageTitle>

<div class="chat-page">
    <div class="messages-area" id="messages-area">
        <div class="messages-inner">
            @if (ChatState.CurrentSession == null || !ChatState.CurrentSession.Messages.Any(m => m.Role != MessageRole.Summary))
            {
                <div class="welcome-message">
                    <span class="material-symbols-outlined welcome-icon">smart_toy</span>
                    <h2>@Strings.CHAT_WELCOME_TITLE</h2>
                    <p>@Strings.CHAT_WELCOME_SUBTITLE</p>
                </div>
            }
            else
            {
                foreach (var msg in ChatState.CurrentSession.Messages.Where(m => m.Role != MessageRole.Summary))
                {
                    <div class="chat-message @(msg.IsUser ? "user" : "assistant")">
                        <div class="message-bubble">
                            @if (msg.IsUser)
                            {
                                @msg.Content
                            }
                            else
                            {
                                @((MarkupString)ConvertMarkdownToHtml(msg.Content))
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="input-area">
        <div class="input-wrapper">
            <textarea @ref="m_TextareaRef"
                      @bind="m_InputText"
                      @bind:event="oninput"
                      @onkeydown="OnInputKeyDown"
                      class="chat-input"
                      placeholder="@Strings.CHAT_INPUT_PLACEHOLDER"
                      disabled="@m_IsStreaming"
                      rows="1"></textarea>
            @if (m_IsStreaming)
            {
                <button @onclick="OnStopClick"
                        class="stop-btn"
                        title="@Strings.CHAT_STOP_BUTTON_TITLE">
                    <span class="material-symbols-outlined">stop_circle</span>
                </button>
            }
            else
            {
                <button @onclick="OnSendClickAsync"
                        class="send-btn"
                        disabled="@string.IsNullOrWhiteSpace(m_InputText)"
                        title="@Strings.CHAT_SEND_BUTTON_TITLE">
                    <span class="material-symbols-outlined">send</span>
                </button>
            }
        </div>
        <p class="input-hint">@Strings.CHAT_INPUT_HINT</p>
    </div>
</div>

@code {
    private const int SUMMARIZE_THRESHOLD = 15;
    private const int SUMMARIZE_KEEP_LAST = 2;

    private string m_InputText = string.Empty;
    private ElementReference m_TextareaRef;
    private bool m_IsStreaming;
    private CancellationTokenSource? m_Cts;

    protected override void OnInitialized()
    {
        ChatState.OnChange += OnChatStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst("sub")?.Value
            ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            await ChatState.InitializeAsync(userId);
        }
    }

    public void Dispose()
    {
        ChatState.OnChange -= OnChatStateChanged;
        m_Cts?.Dispose();
    }

    private void OnChatStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("attachChatInput", m_TextareaRef);
        }
    }

    private async Task<string> GetUserIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirst("sub")?.Value
            ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("User is not authenticated.");
    }

    private async Task OnSendClickAsync()
    {
        var text = m_InputText.Trim();
        if (string.IsNullOrWhiteSpace(text) || m_IsStreaming)
            return;

        m_InputText = string.Empty;
        m_IsStreaming = true;
        m_Cts = new CancellationTokenSource();

        ChatSession? currentSession = null;
        ChatMessage? userMessage = null;
        ChatMessage? assistantMessage = null;

        try
        {
            if (ChatState.CurrentSession == null)
            {
                var userId = await GetUserIdAsync();
                var topics = await AIMessenger.GenerateConversationTopicsAsync(text, m_Cts.Token);
                await ChatState.CreateSessionAsync(userId, topics, m_Cts.Token);
            }

            currentSession = ChatState.CurrentSession!;

            // Capture history BEFORE adding the new messages
            var history = currentSession.Messages
                .Select(m => new ChatHistoryMessage(m.Role, m.Content))
                .ToList();

            userMessage = new ChatMessage { Role = MessageRole.User, Content = text };
            currentSession.Messages.Add(userMessage);

            assistantMessage = new ChatMessage { Role = MessageRole.Assistant, Content = string.Empty };
            currentSession.Messages.Add(assistantMessage);

            StateHasChanged();
            await JS.InvokeVoidAsync("scrollToBottom", "messages-area");

            await foreach (var chunk in currentSession.Chat.AddChatAsync(history, text, m_Cts.Token))
            {
                assistantMessage.Content += chunk;
                StateHasChanged();
                await JS.InvokeVoidAsync("scrollToBottom", "messages-area");
            }
        }
        catch (OperationCanceledException)
        {
            // User cancelled — fall through to persist whatever was received
        }
        finally
        {
            if (currentSession != null && userMessage != null && assistantMessage != null)
            {
                userMessage.DbId = await ChatRepository.AddMessageAsync(
                    currentSession.SessionId, MessageRole.User, text);

                if (!string.IsNullOrEmpty(assistantMessage.Content))
                {
                    assistantMessage.DbId = await ChatRepository.AddMessageAsync(
                        currentSession.SessionId, MessageRole.Assistant, assistantMessage.Content);
                }

                await CheckAndSummarizeAsync(currentSession);
            }

            m_IsStreaming = false;
            m_Cts?.Dispose();
            m_Cts = null;
            StateHasChanged();
        }
    }

    private async Task CheckAndSummarizeAsync(ChatSession session)
    {
        var regularMessages = session.Messages
            .Where(m => m.Role != MessageRole.Summary)
            .ToList();

        if (regularMessages.Count < SUMMARIZE_THRESHOLD)
            return;

        // Summarize oldest (count - SUMMARIZE_KEEP_LAST) messages, keep the last few
        int toSummarizeCount = regularMessages.Count - SUMMARIZE_KEEP_LAST;
        var toSummarize = regularMessages.Take(toSummarizeCount).ToList();
        var historyForSummary = toSummarize
            .Select(m => new ChatHistoryMessage(m.Role, m.Content))
            .ToList();

        var summaryContent = await session.Chat.SummarizeAsync(historyForSummary);

        var idsToDelete = toSummarize
            .Where(m => m.DbId.HasValue)
            .Select(m => m.DbId.GetValueOrDefault());

        var summaryDbId = await ChatRepository.ReplaceWithSummaryAsync(
            session.SessionId, idsToDelete, summaryContent);

        // Update in-memory list: remove summarized messages, insert summary at front
        foreach (var msg in toSummarize)
            session.Messages.Remove(msg);

        session.Messages.Insert(0, new ChatMessage
        {
            Role = MessageRole.Summary,
            Content = summaryContent,
            DbId = summaryDbId
        });
    }

    private void OnStopClick()
    {
        m_Cts?.Cancel();
    }

    private void OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _ = InvokeAsync(OnSendClickAsync);
        }
    }

    private static readonly MarkdownPipeline s_MarkdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private static string ConvertMarkdownToHtml(string? markdown)
    {
        if (string.IsNullOrEmpty(markdown))
            return string.Empty;
        return Markdown.ToHtml(markdown, s_MarkdownPipeline);
    }
}
