@inherits LayoutComponentBase
@inject ChatStateService ChatState
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <AuthorizeView Roles="admin" Context="Sidebar">
                    <Authorized>
                        <ChatSidebar />
                    </Authorized>
                </AuthorizeView>
            </div>

            <main>
                <div class="top-row px-4">
                    <span class="conversation-title">
                        <AuthorizeView Roles="admin" Context="ConversationTitle">
                            <Authorized>
                                @(ChatState.CurrentSession?.Chat.ConversationTopics ?? Strings.TOPBAR_DEFAULT_CONVERSATION_TITLE)
                            </Authorized>
                        </AuthorizeView>
                    </span>
                    <ProfileCard />
                </div>

                <article class="content">
                    <AuthorizeView Roles="admin" Context="Content">
                        <Authorized>
                            @Body
                        </Authorized>
                        <NotAuthorized>
                            <ErrorView ErrorTextBody="@Strings.ERROR_PERMISSION_DENIED" ErrorText="@string.Format(Strings.ERROR_PERMISSION_DENIED_DESCRIPTION, "admin")" />
                        </NotAuthorized>
                    </AuthorizeView>
                </article>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    @Strings.ERROR_UNHANDLED
    <a href="." class="reload">@Strings.ERROR_RELOAD</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        ChatState.OnChange += OnChatStateChanged;
    }

    public void Dispose()
    {
        ChatState.OnChange -= OnChatStateChanged;
    }

    private void OnChatStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }
}
