@page "/auth/register/{ID}"
@using Management.Components.Layout
@using Management.Configurations
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Scripting.DTO
@layout NotAuthorizedLayout
@inject NavigationManager Navigation
@inject ILogger<Register> Logger
@inject HttpClient Http
@inject IOptions<BackendUrls> Urls

<div class="register-form" style="position:relative;">
    <div style="display:flex; flex-direction:row; align-items:center; justify-content:left; margin-bottom:8px;">
        <button class="back-button" @onclick="OnBackButtonClicked">&#8592; Back</button>
        <div style="font-weight:bold; font-size:16px; margin-left:16px;">Continuing registration with '@ID'.</div>
    </div>
    <div style="display:flex; flex-direction:column; gap:12px;">
        <div class="floating-group">
            <input id="pw" type="password" class="login-input floating-input" placeholder=" " @bind-value="Password" @oninput="UpdateLayout" />
            <label for="pw" class="floating-label">Password</label>
        </div>
        <div class="floating-group">
            <input id="email" type="email" class="login-input floating-input" placeholder=" " @bind-value="Email" @oninput="UpdateLayout" />
            <label for="email" class="floating-label">Email</label>
        </div>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="input-error">@ErrorMessage</div>
        }
    </div>
    <div class="login-buttons-row register-buttons-row">
        <button disabled="@CannotSubmit" @onclick="OnSubmitRegisterAsync">Submit</button>
    </div>
</div>
