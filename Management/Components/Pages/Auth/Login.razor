@page "/auth/login"
@using Management.Components.Layout
@using Management.Components.Shared
@using Management.Configurations
@using Management.Services
@using Microsoft.Extensions.Options
@using System.Net
@using System.Text.RegularExpressions
@layout NotAuthorizedLayout
@implements IAsyncDisposable
@inject ILogger<Login> Logger
@inject HttpClient Http
@inject IOptions<BackendUrls> Urls
@inject NavigationManager Navigation
@inject AuthProvider Auth
@inject IJSRuntime JSRuntime

<div class="login-form">
    <div style="display:flex; flex-direction:row; gap:10px; padding-bottom: 20px;">
        <h2 class="title">
            @LoginStrings.FORM_TITLE
        </h2>
        <form class="input-form" @onsubmit="OnContinueAsync">
            <SelectorContainer View="ViewState">
                <SelectorView Key="RenderStates.Id">
                    <FloatingInput Type="text" Placeholder="@LoginStrings.LABEL_ID" @bind-Value="Id" Input="@OnChangedAsync" HasError="@IdError" />
                </SelectorView>
                <SelectorView Key="RenderStates.Login">
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        <FloatingInput Type="text" Placeholder="@LoginStrings.LABEL_ID" Value="@Id" Disabled="true" />
                        <FloatingInput @ref="m_InputPassword" Type="password" Placeholder="@LoginStrings.LABEL_PW" @bind-Value="Password" Input="@OnChangedAsync" HasError="@PasswordError" />
                    </div>
                </SelectorView>
                <SelectorView Key="RenderStates.Register">
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        <FloatingInput Type="text" Placeholder="@LoginStrings.LABEL_ID" Value="@Id" Disabled="true" />
                        <FloatingInput @ref="m_InputPassword" Type="password" Placeholder="@LoginStrings.LABEL_PW" @bind-Value="Password" Input="@OnChangedAsync" HasError="@PasswordError" />
                        <FloatingInput Type="text" Placeholder="@LoginStrings.LABEL_EMAIL" @bind-Value="Email" Input="@OnChangedAsync" HasError="@EmailError" />
                    </div>
                </SelectorView>
            </SelectorContainer>
            <div>
                @foreach (var error in GetErrorMessages())
                {
                    <p class="error-message">
                        <span class="material-symbols-outlined error-message">error</span>
                        <span class="error-message">@error</span>
                    </p>
                }
            </div>
            <div class="login-buttons-row">
                @if (ViewState is RenderStates.Id)
                {
                    <button type="button" onclick="@OnRegisterAsync" disabled="@(CanSubmit == false)">@LoginStrings.BUTTON_REGISTER</button>
                }
                else
                {
                    <button type="button" onclick="@OnReturnAsync">@LoginStrings.BUTTON_RETURN</button>
                }
                <button type="submit" disabled="@(CanSubmit == false)">@LoginStrings.BUTTON_CONTINUE</button>
            </div>
        </form>
    </div>
    <AsyncOperationProgress Display="@Requesting" />
</div>

@code {
    private enum RenderStates
    {
        Id,
        Login,
        Register
    }

    private struct RequestScope : IDisposable
    {
        private readonly Login m_Component;

        public RequestScope(Login component)
        {
            m_Component = component;
            Interlocked.Increment(ref component.m_Requesting);
            component.StateHasChanged();
        }

        public void Dispose()
        {
            Interlocked.Decrement(ref m_Component.m_Requesting);
            m_Component.StateHasChanged();
        }
    }

    private record LoginResponse(bool Ok, int Status);

    private IJSObjectReference m_Module = null!;
    private int m_Requesting = 0;
    private string m_ErrorMessageId = string.Empty;
    private string m_ErrorMessagePassword = string.Empty;
    private string m_ErrorMessageEmail = string.Empty;
    private FloatingInput m_InputPassword = null!;

    private bool IdError => string.IsNullOrEmpty(m_ErrorMessageId) == false;
    private string Password { get; set; } = string.Empty;
    private bool PasswordError => string.IsNullOrEmpty(m_ErrorMessagePassword) == false;
    private string Email { get; set; } = string.Empty;
    private bool EmailError => string.IsNullOrEmpty(m_ErrorMessageEmail) == false;

    private bool CanSubmit => string.IsNullOrEmpty(Id) == false;
    private bool Requesting => m_Requesting > 0;

    [SupplyParameterFromQuery]
    public string? View { get; set; }
    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    private RenderStates ViewState
    {
        get
        {
            if (Enum.TryParse<RenderStates>(View ?? string.Empty, true, out var value))
            {
                return value;
            }

            return RenderStates.Id;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (m_Module is not null)
        {
            try
            {
                await m_Module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            m_Module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Auth/Login.razor.js");
            if (m_Module == null)
            {
                Logger.LogCritical("Failed to load JS module for login page. Please check that the JavaScript file is in the correct location.");
            }
        }
    }

    private IEnumerable<string> GetErrorMessages()
    {
        if (string.IsNullOrEmpty(m_ErrorMessageId) == false)
        {
            yield return m_ErrorMessageId;
        }

        if (string.IsNullOrEmpty(m_ErrorMessagePassword) == false)
        {
            yield return m_ErrorMessagePassword;
        }

        if (string.IsNullOrEmpty(m_ErrorMessageEmail) == false)
        {
            yield return m_ErrorMessageEmail;
        }
    }

    private async ValueTask OnRegisterAsync(MouseEventArgs e)
    {
        using var scope1 = new RequestScope(this);

        switch (ViewState)
        {
            case RenderStates.Id:
                break;
            default:
                Logger.LogError("Unexpected view state. Expected: Id, Current: {ViewState}", ViewState);
                return;
        }

        var response = await Http.GetAsync($"{Urls.Value.Auth}/api/auth?id={Uri.EscapeDataString(Id ?? string.Empty)}");
        if (response.StatusCode == HttpStatusCode.OK)
        {
            m_ErrorMessageId = LoginStrings.VALIDATION_ERROR_ID_ALREADY_EXISTS;
            return;
        }

        Navigation.NavigateTo($"/auth/login?view=register&id={Uri.EscapeDataString(Id)}");
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(TimeSpan.FromSeconds(0.4));
            await m_InputPassword.FocusAsync();
        });
    }

    private async ValueTask OnReturnAsync(MouseEventArgs e)
    {
        switch (ViewState)
        {
            case RenderStates.Login or RenderStates.Register:
                await JSRuntime.InvokeVoidAsync("compareNavigateTo", "/auth/login");
                break;
        }
    }

    private async Task OnContinueAsync()
    {
        switch (ViewState)
        {
            case RenderStates.Id:
                await OnContinue_StateIdAsync();
                break;
            case RenderStates.Login:
                await OnContinue_StateLoginAsync();
                break;
            case RenderStates.Register:
                await OnContinue_StateRegisterAsync();
                break;
        }
    }

    private async Task OnContinue_StateRegisterAsync()
    {
        using var scope1 = new RequestScope(this);

        bool hasError = false;
        if (string.IsNullOrEmpty(Password))
        {
            m_ErrorMessagePassword = LoginStrings.VALIDATION_ERROR_PW_REQUIRED;
            hasError = true;
        }

        if (string.IsNullOrEmpty(Email))
        {
            m_ErrorMessageEmail = LoginStrings.VALIDATION_ERROR_EMAIL_REQUIRED;
            hasError = true;
        }
        else if (ValidEmailRegex().IsMatch(Email) == false)
        {
            m_ErrorMessageEmail = LoginStrings.VALIDATION_ERROR_EMAIL_INVALID_FORMAT;
            hasError = true;
        }

        if (hasError)
        {
            return;
        }

        var code = $"{Id}${Password}";
        var registerUrl = $"{Urls.Value.Auth}/api/auth/{Uri.EscapeDataString(Id ?? string.Empty)}?password={Uri.EscapeDataString(Password)}&email={Uri.EscapeDataString(Email)}";
        var result = await m_Module.InvokeAsync<LoginResponse>("registerAsync", registerUrl);
        if (!result.Ok || result.Status == 401)
        {
            m_ErrorMessagePassword = LoginStrings.VALIDATION_ERROR_PW_INVALID;
        }
        else if (result.Ok)
        {
            m_ErrorMessageId = string.Empty;
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task OnContinue_StateLoginAsync()
    {
        using var scope1 = new RequestScope(this);

        var code = $"{Id}${Password}";
        var loginUrl = $"{Urls.Value.Auth}/api/auth/self-provide/login?code={Uri.EscapeDataString(code)}";
        var result = await m_Module.InvokeAsync<LoginResponse>("loginAsync", loginUrl);
        if (!result.Ok || result.Status == 401)
        {
            m_ErrorMessagePassword = LoginStrings.VALIDATION_ERROR_PW_INVALID;
        }
        else if (result.Ok)
        {
            m_ErrorMessageId = string.Empty;
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task OnContinue_StateIdAsync()
    {
        using var scope1 = new RequestScope(this);

        if (string.IsNullOrEmpty(Id))
        {
            m_ErrorMessageId = LoginStrings.VALIDATION_ERROR_ID_REQUIRED;
            return;
        }

        var response = await Http.GetAsync($"{Urls.Value.Auth}/api/auth?id={Uri.EscapeDataString(Id)}");
        if (response.StatusCode == HttpStatusCode.NotFound)
        {
            m_ErrorMessageId = LoginStrings.VALIDATION_ERROR_ID_NOT_FOUND;
            return;
        }

        Navigation.NavigateTo($"/auth/login?view=login&id={Uri.EscapeDataString(Id)}");
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(TimeSpan.FromSeconds(0.4));
            await m_InputPassword.FocusAsync();
        });
    }

    private Task OnChangedAsync()
    {
        m_ErrorMessageId = string.Empty;
        m_ErrorMessagePassword = string.Empty;
        m_ErrorMessageEmail = string.Empty;
        return Task.CompletedTask;
    }
}