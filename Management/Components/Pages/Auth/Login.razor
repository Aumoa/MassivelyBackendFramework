@page "/auth/login"
@using Management.Components.Layout
@using Management.Configurations
@using Management.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using System.Net
@using Microsoft.Extensions.Options
@using Management.Components.Pages
@layout NotAuthorizedLayout
@inject ILogger<Login> Logger
@inject HttpClient Http
@inject IOptions<BackendUrls> Urls
@inject NavigationManager Navigation
@inject AuthProvider Auth
@inject IJSRuntime JSRuntime

<PageTitle>Management - Login</PageTitle>

<AuthorizeView>
    <Authorized>
        <RedirectToMain />
    </Authorized>
    <NotAuthorized>
        <div class="login-form" style="position:relative;">
            <form @onsubmit="OnContinueButtonClickedAsync">
                <div style="display:flex; flex-direction:column; gap:24px;">
                    <div class="floating-group" style="min-height:44px;">
                        <input id="id" type="text" class="login-input floating-input" placeholder=" " @bind-value="m_ID" @oninput="ClearErrorMessage" @onkeydown="HandleIdKeyDown" />
                        <label for="id" class="floating-label">ID</label>
                    </div>
                    @if (m_Step == 1)
                    {
                        <div class="floating-group slide-fade-in" style="min-height:44px;">
                            <input id="pw" type="password" class="login-input floating-input" placeholder=" " @bind-value="m_Password" @bind-value:event="oninput" @ref="pwInputRef" />
                            <label for="pw" class="floating-label">Password</label>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(m_ErrorMessage))
                    {
                        <div class="input-error">@m_ErrorMessage</div>
                    }
                </div>
                <div class="login-buttons-row">
                    <button type="button" style="background: transparent;" disabled="@string.IsNullOrWhiteSpace(m_ID)" @onclick="OnRegisterButtonClicked">Register</button>
                    <button type="submit" disabled="@string.IsNullOrWhiteSpace(m_ID)">Continue</button>
                </div>
            </form>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ElementReference pwInputRef;
    private async Task HandleIdKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && m_Step == 1)
        {
            await pwInputRef.FocusAsync();
        }
    }
}
