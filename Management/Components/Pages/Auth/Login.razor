@page "/auth/login"
@using Management.Components.Layout
@using Management.Configurations
@using Management.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using System.Net
@using Microsoft.Extensions.Options
@using Management.Components.Pages
@layout NotAuthorizedLayout
@inject ILogger<Login> Logger
@inject HttpClient Http
@inject IOptions<BackendUrls> Urls
@inject NavigationManager Navigation
@inject AuthProvider Auth
@inject IJSRuntime JSRuntime

<div class="login-form" style="position:relative;">
    <div style="display:flex; flex-direction:row; gap:10px; padding-bottom: 20px;">
        <h2 class="title">
            @LoginStrings.FORM_TITLE
        </h2>
        <form @onsubmit="OnContinueButtonClickedAsync">
            @if (m_States.Count == 1)
            {
                @switch (m_States.Last())
                {
                    @case RenderStates.None:
                        <div class="input-form">
                            <div class="floating-group">
                                <input id="id" type="text" class="floating-input @(HasError ? "error" : "")" @bind-value="ID" placeholder=" " @oninput="ClearErrorMessage" />
                                <label for="id" class="floating-label @(HasError ? "error" : "")">@LoginStrings.LABEL_ID</label>
                            </div>
                        </div>
                        break;
                    @case RenderStates.Login:
                        <div class="input-form">
                            <div class="floating-group">
                                <input id="pw" type="password" class="floating-input @(HasError ? "error" : "")" @bind-value="Password" placeholder=" " @oninput="ClearErrorMessage" />
                                <label for="pw" class="floating-label @(HasError ? "error" : "")">@LoginStrings.LABEL_PW</label>
                            </div>
                        </div>
                        break;
                }
            }
            else
            {
                <div style="display:flex; flex-direction:row; gap:10px;">
                    @switch (m_States[0])
                    {
                        case RenderStates.None:
                            <div class="input-form slide-out">
                                <div class="floating-group">
                                    <input id="id" type="text" class="floating-input @(HasError ? "error" : "")" @bind-value="ID" placeholder=" " @oninput="ClearErrorMessage" />
                                    <label for="id" class="floating-label @(HasError ? "error" : "")">@LoginStrings.LABEL_ID</label>
                                </div>
                            </div>
                            break;
                        case RenderStates.Login:
                            <div class="input-form slide-out">
                                <div class="floating-group">
                                    <input id="pw" type="password" class="floating-input @(HasError ? "error" : "")" @bind-value="Password" placeholder=" " @oninput="ClearErrorMessage" />
                                    <label for="pw" class="floating-label @(HasError ? "error" : "")">@LoginStrings.LABEL_PW</label>
                                </div>
                            </div>
                            break;
                    }
                    @switch (m_States[1])
                    {
                        case RenderStates.None:
                            <div class="input-form slide-in">
                                <div class="floating-group">
                                    <input id="id" type="text" class="floating-input @(HasError ? "error" : "")" @bind-value="ID" placeholder=" " @oninput="ClearErrorMessage" />
                                    <label for="id" class="floating-label @(HasError ? "error" : "")">@LoginStrings.LABEL_ID</label>
                                </div>
                            </div>
                            break;
                        case RenderStates.Login:
                            <div class="input-form slide-in">
                                <div class="floating-group">
                                    <input id="pw" type="password" class="floating-input @(HasError ? "error" : "")" @bind-value="Password" placeholder=" " @oninput="ClearErrorMessage" />
                                    <label for="pw" class="floating-label @(HasError ? "error" : "")">@LoginStrings.LABEL_PW</label>
                                </div>
                            </div>
                            break;
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="input-error">@ErrorMessage</div>
            }
            <div class="login-buttons-row">
                <button type="submit" disabled="@string.IsNullOrWhiteSpace(ID)">@LoginStrings.BUTTON_CONTINUE</button>
            </div>
        </form>
    </div>
    <div class="progress-bar-container @(Requesting ? "visible" : "")">
        <div class="progress-bar" />
    </div>
</div>