<div class="floating-group">
    @{
        string extendClass = ErrorAndEnabled ? "error" : string.Empty;
    }
    <input @ref="m_Input"
           id="@GetHashCode()"
           type="@Type"
           class="floating-input @extendClass"
           value="@Value"
           oninput="@OnInputAsync"
           onchange="@OnChangeAsync"
           placeholder=" "
           disabled="@Disabled"
           autocomplete="@AutoComplete" />
    <label for="@GetHashCode()" class="floating-label @extendClass">@Placeholder</label>
</div>

@code {



    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> Input { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> Changed { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool HasError { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? AutoComplete { get; set; }

    private bool ErrorAndEnabled => HasError && Disabled == false;

    private ElementReference m_Input;

    private async ValueTask OnInputAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
        await Input.InvokeAsync(e);
    }

    private async ValueTask OnChangeAsync(ChangeEventArgs e)
    {
        await Changed.InvokeAsync(e);
    }

    public async ValueTask FocusAsync()
    {
        await m_Input.FocusAsync();
    }
}