{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "RedisConnectionString": "localhost:6379"
  },
  "RCON": {
    "Host": "127.0.0.1",
    "Port": 25575,
    "Password": ""
  },
  "OIDC": {
    "Uri": "https://localhost:7009",
    "ClientId": "minecraft-sidecar",
    "ClientSecret": "secret"
  },
  "ServerLog": {
    "LogFilePath": "/app/logs/latest.log",
    "InitialLines": 200,
    "PollingIntervalMs": 100
  },
  "ServerProperties": {
    "FilePath": "/app/server.properties",
    "EnvironmentVariablePrefix": "MINECRAFT_PROPERTY_",
    "DefaultProperties": {}
  }
}
