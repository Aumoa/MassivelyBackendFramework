@page "/"
@rendermode InteractiveServer
@inject RCONClient RconClient
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>@Strings.APP_TITLE - @Strings.DASHBOARD_TITLE</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>
                        <span class="material-symbols-outlined" style="vertical-align: middle;">dashboard</span>
                        @Strings.DASHBOARD_TITLE
                    </h1>
                    <p class="lead">@Strings.DASHBOARD_SUBTITLE</p>
                </div>
                <div>
                    <button class="btn btn-outline-primary" @onclick="RefreshStatus">
                        <span class="material-symbols-outlined" style="vertical-align: middle; font-size: 18px;">refresh</span>
                        @Strings.BUTTON_REFRESH
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="material-symbols-outlined">dns</span>
                        @Strings.DASHBOARD_CARD_SERVER_STATUS
                    </h5>
                    <p class="card-text">
                        @if (isChecking)
                        {
                            <span class="badge bg-secondary">@Strings.DASHBOARD_STATUS_CHECKING</span>
                        }
                        else
                        {
                            <span class="badge @(isServerRunning ? "bg-success" : "bg-danger")">
                                @(isServerRunning ? Strings.DASHBOARD_STATUS_RUNNING : Strings.DASHBOARD_STATUS_STOPPED)
                            </span>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <small class="text-muted">@statusMessage</small>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="material-symbols-outlined">group</span>
                        @Strings.DASHBOARD_CARD_PLAYERS_ONLINE
                    </h5>
                    <p class="card-text">@playersOnline / @maxPlayers</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="material-symbols-outlined">memory</span>
                        @Strings.DASHBOARD_CARD_SERVER_PERFORMANCE
                    </h5>
                    <p class="card-text">
                        @if (serverTps > 0)
                        {
                            <span class="badge @GetTpsBadgeClass()">
                                TPS: @serverTps.ToString("F1")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(tpsMessage))
                    {
                        <small class="text-muted">@tpsMessage</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5>@Strings.DASHBOARD_CARD_PERFORMANCE_HISTORY</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        @foreach (var tpsEntry in tpsHistory.TakeLast(20))
                        {
                            <div style="width: 4%; height: 100px; background: linear-gradient(to top, @GetTpsColor(tpsEntry.Tps) 0%, @GetTpsColor(tpsEntry.Tps) @((tpsEntry.Tps / 20.0 * 100))%, transparent @((tpsEntry.Tps / 20.0 * 100))%); border-radius: 2px;" title="@tpsEntry.Timestamp.ToString("HH:mm:ss") - TPS: @tpsEntry.Tps.ToString("F1")"></div>
                        }
                    </div>
                    <div class="text-center mt-2">
                        <small class="text-muted">@Strings.DASHBOARD_PERFORMANCE_CAPTION</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isServerRunning = false;
    private bool isChecking = false;
    private int playersOnline = 0;
    private int maxPlayers = 20;
    private double serverTps = 0.0;
    private string statusMessage = string.Empty;
    private string tpsMessage = string.Empty;
    private System.Threading.Timer? _timer;
    private List<TpsEntry> tpsHistory = new();
    private DateTime? lastGameTimeCheck = null;
    private long? lastGameTime = null;

    protected override async Task OnInitializedAsync()
    {
        await CheckServerStatus();

        // 5�ʸ��� ���� ���� Ȯ��
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await CheckServerStatus();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshStatus()
    {
        await CheckServerStatus();
    }

    private async Task CheckServerStatus()
    {
        isChecking = true;
        StateHasChanged();

        try
        {
            // RCON ���� ��������
            var rconSettings = Configuration.GetSection("RCON");
            var host = rconSettings.GetValue<string>("Host") ?? "127.0.0.1";
            var port = rconSettings.GetValue<int>("Port");

            // �̹� ����Ǿ� ���� �ʴٸ� ���� �õ�
            if (!RconClient.IsConnected)
            {
                statusMessage = $"Unable to connect to {host}:{port}";
                playersOnline = 0;
                serverTps = 0.0;
                tpsMessage = "Server offline";
                return;
            }

            // ���� ���� ��ȸ
            try
            {
                // list �������� �÷��̾� �� Ȯ��
                var listResponse = await RconClient.SendCommandAsync("list");
                ParsePlayerList(listResponse);
                
                // TPS ���� �õ�
                await MeasureTps();
                
                isServerRunning = true;
                statusMessage = $"Connected to {host}:{port}";
            }
            catch (Exception ex)
            {
                // ���� ���� �� ���� ���� �� ��õ�
                isServerRunning = false;
                statusMessage = $"Command failed: {ex.Message}";
                playersOnline = 0;
                serverTps = 0.0;
            }
        }
        catch (Exception ex)
        {
            isServerRunning = false;
            statusMessage = $"Error: {ex.Message}";
            playersOnline = 0;
            serverTps = 0.0;
        }
        finally
        {
            isChecking = false;
            StateHasChanged();
        }
    }

    private async Task MeasureTps()
    {
        try
        {
            // ��� 1: /tps ���ɾ� �õ� (Spigot/Paper)
            try
            {
                var tpsResponse = await RconClient.SendCommandAsync("tps");
                if (!tpsResponse.Contains("Unknown command") && !tpsResponse.Contains("Unknown or incomplete command"))
                {
                    ParseTpsCommand(tpsResponse);
                    tpsMessage = "Using /tps command";
                    return;
                }
            }
            catch { }

            // ��� 2: ���� �ð� ��� ��� (�ٴҶ� ����)
            var currentTime = DateTime.UtcNow;
            var gameTimeResponse = await RconClient.SendCommandAsync("time query gametime");
            
            if (gameTimeResponse.Contains("The time is"))
            {
                var gameTime = ParseGameTime(gameTimeResponse);
                
                if (lastGameTime.HasValue && lastGameTimeCheck.HasValue)
                {
                    var timeDiff = (currentTime - lastGameTimeCheck.Value).TotalSeconds;
                    var tickDiff = gameTime - lastGameTime.Value;
                    
                    if (timeDiff > 0)
                    {
                        var calculatedTps = tickDiff / timeDiff;
                        serverTps = Math.Min(20.0, Math.Max(0, calculatedTps));
                        
                        tpsHistory.Add(new TpsEntry(currentTime, serverTps));
                        if (tpsHistory.Count > 50)
                        {
                            tpsHistory.RemoveAt(0);
                        }
                        
                        tpsMessage = "Calculated from game time";
                    }
                }
                
                lastGameTime = gameTime;
                lastGameTimeCheck = currentTime;
            }
            else
            {
                // TPS�� ������ �� ���� ��� - ���� ������ �����Ƿ� 20.0���� ����
                serverTps = 20.0;
                tpsMessage = "Estimated (no TPS data available)";
            }
        }
        catch (Exception ex)
        {
            tpsMessage = $"TPS check failed: {ex.Message}";
            serverTps = 0.0;
        }
    }

    private void ParseTpsCommand(string response)
    {
        // "TPS from last 1m, 5m, 15m: 20.0, 20.0, 20.0" ���� �Ľ�
        var parts = response.Split(':');
        if (parts.Length >= 2)
        {
            var tpsValues = parts[1].Split(',');
            if (tpsValues.Length > 0 && double.TryParse(tpsValues[0].Trim(), out var tps))
            {
                serverTps = tps;
                tpsHistory.Add(new TpsEntry(DateTime.UtcNow, serverTps));
                if (tpsHistory.Count > 50)
                {
                    tpsHistory.RemoveAt(0);
                }
            }
        }
    }

    private long ParseGameTime(string response)
    {
        // "The time is 12345" ���Ŀ��� ���� ����
        var parts = response.Split(' ');
        for (int i = 0; i < parts.Length; i++)
        {
            if (long.TryParse(parts[i], out var time))
            {
                return time;
            }
        }
        return 0;
    }

    private void ParsePlayerList(string response)
    {
        // "There are 0 of a max of 20 players online:" ���� �Ľ�
        if (response.Contains("players online"))
        {
            var parts = response.Split(' ');
            if (parts.Length >= 3 && int.TryParse(parts[2], out var online))
            {
                playersOnline = online;
            }
            if (parts.Length >= 7 && int.TryParse(parts[6], out var max))
            {
                maxPlayers = max;
            }
        }
    }

    private string GetTpsBadgeClass()
    {
        if (serverTps >= 19.5) return "bg-success";
        if (serverTps >= 18.0) return "bg-warning";
        return "bg-danger";
    }

    private string GetTpsColor(double tps)
    {
        if (tps >= 19.5) return "#28a745"; // Green
        if (tps >= 18.0) return "#ffc107"; // Yellow
        return "#dc3545"; // Red
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private record TpsEntry(DateTime Timestamp, double Tps);
}
