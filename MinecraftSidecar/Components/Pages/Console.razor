@page "/console"
@rendermode InteractiveServer
@inject RCONClient RconClient
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>@Strings.APP_TITLE - @Strings.CONSOLE_TITLE</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1>
                    <span class="material-symbols-outlined" style="vertical-align: middle;">terminal</span>
                    @Strings.CONSOLE_TITLE
                </h1>
                <div>
                    @if (RconClient.IsConnected)
                    {
                        <span class="badge bg-success">@Strings.CONSOLE_STATUS_CONNECTED</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Strings.CONSOLE_STATUS_DISCONNECTED</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="console-output" style="background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 4px; min-height: 400px; max-height: 600px; font-family: 'Consolas', monospace; overflow-y: auto;">
                        @foreach (var log in consoleOutput)
                        {
                            <p style="margin: 0; padding: 2px 0; white-space: pre-wrap; word-break: break-word;">@log</p>
                        }
                    </div>
                    <div class="console-input mt-3">
                        <div class="input-group">
                            <span class="input-group-text">></span>
                            <input type="text" 
                                   class="form-control" 
                                   placeholder="@Strings.CONSOLE_INPUT_PLACEHOLDER" 
                                   @bind="commandInput" 
                                   @bind:event="oninput" 
                                   @onkeypress="OnKeyPress"
                                   disabled="@(!RconClient.IsConnected)" />
                            <button class="btn btn-primary" @onclick="SendCommand" disabled="@(!RconClient.IsConnected)">@Strings.CONSOLE_BUTTON_SEND</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<string> consoleOutput = new()
    {
        Strings.CONSOLE_LOG_INITIALIZED,
        Strings.CONSOLE_LOG_CONNECT_HINT
    };

    private string commandInput = string.Empty;

    protected override Task OnInitializedAsync()
    {
        RconClient.Connected += OnConnected;
        RconClient.Disconnected += OnDisconnected;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        RconClient.Connected -= OnConnected;
        RconClient.Disconnected -= OnDisconnected;
        GC.SuppressFinalize(this);
    }

    private void OnConnected()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnDisconnected()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SendCommand()
    {
        if (!string.IsNullOrWhiteSpace(commandInput) && RconClient.IsConnected)
        {
            consoleOutput.Add($"> {commandInput}");
            
            try
            {
                var response = await RconClient.SendCommandAsync(commandInput);
                
                if (!string.IsNullOrWhiteSpace(response))
                {
                    consoleOutput.Add($"  {response}");
                }
                else
                {
                    consoleOutput.Add(Strings.CONSOLE_LOG_COMMAND_SUCCESS);
                }
            }
            catch (Exception ex)
            {
                consoleOutput.Add(string.Format(Strings.CONSOLE_LOG_COMMAND_FAILED, ex.Message));
                
                // ������ ������ ���
                if (!RconClient.IsConnected)
                {
                    consoleOutput.Add(Strings.CONSOLE_LOG_CONNECTION_LOST);
                }
            }
            
            commandInput = string.Empty;
            StateHasChanged();
        }
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendCommand();
        }
    }
}
