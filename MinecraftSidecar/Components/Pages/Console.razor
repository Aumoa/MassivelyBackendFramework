@page "/console"
@rendermode InteractiveServer
@inject RCONClient RconClient
@inject ConsoleLogService LogService
@inject IJSRuntime JS
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PageTitle>@Strings.APP_TITLE - @Strings.CONSOLE_TITLE</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1>
                    <span class="material-symbols-outlined" style="vertical-align: middle;">terminal</span>
                    @Strings.CONSOLE_TITLE
                </h1>
                <div>
                    @if (RconClient.IsConnected)
                    {
                        <span class="badge bg-success">@Strings.CONSOLE_STATUS_CONNECTED</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Strings.CONSOLE_STATUS_DISCONNECTED</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div id="console-output"
                         class="console-output"
                         style="background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 4px; min-height: 400px; max-height: 600px; font-family: 'Consolas', monospace; overflow-y: auto;">
                        @foreach (var entry in snapshot)
                        {
                            <p style="margin: 0; padding: 2px 0; white-space: pre-wrap; word-break: break-word; color: @GetEntryColor(entry.Level);">@FormatEntry(entry)</p>
                        }
                    </div>
                    <div class="console-input mt-3">
                        <div class="input-group">
                            <span class="input-group-text">></span>
                            <input type="text"
                                   class="form-control"
                                   placeholder="@Strings.CONSOLE_INPUT_PLACEHOLDER"
                                   @bind="commandInput"
                                   @bind:event="oninput"
                                   @onkeypress="OnKeyPress"
                                   disabled="@(!RconClient.IsConnected || isSending)" />
                            <button class="btn btn-primary" @onclick="OnSendClick" disabled="@(!RconClient.IsConnected || isSending)">@Strings.CONSOLE_BUTTON_SEND</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<ConsoleLogEntry> snapshot = Array.Empty<ConsoleLogEntry>();
    private string commandInput = string.Empty;
    private bool isSending;
    private IDisposable? _subscription;

    protected override Task OnInitializedAsync()
    {
        snapshot = LogService.GetSnapshot();

        _subscription = LogService.Subscribe(OnLogUpdated);

        RconClient.Connected += OnConnectionChanged;
        RconClient.Disconnected += OnConnectionChanged;

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottomAsync();
        }
    }

    private async Task OnLogUpdated()
    {
        snapshot = LogService.GetSnapshot();
        await InvokeAsync(StateHasChanged);
        await InvokeAsync(ScrollToBottomAsync);
    }

    private void OnConnectionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnSendClick()
    {
        await SendCommand();
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendCommand();
        }
    }

    private async Task SendCommand()
    {
        if (string.IsNullOrWhiteSpace(commandInput) || !RconClient.IsConnected || isSending)
            return;

        var cmd = commandInput.Trim();
        commandInput = string.Empty;
        isSending = true;
        StateHasChanged();

        LogService.Append(ConsoleLogLevel.Command, $"> {cmd}");

        try
        {
            var response = await RconClient.SendCommandAsync(cmd);

            if (!string.IsNullOrWhiteSpace(response))
            {
                LogService.Append(ConsoleLogLevel.Response, response.Replace("\r\n", "\n").Replace("\r", "\n"));
            }
            else
            {
                LogService.Append(ConsoleLogLevel.Info, Strings.CONSOLE_LOG_COMMAND_SUCCESS);
            }
        }
        catch (Exception ex)
        {
            LogService.Append(ConsoleLogLevel.Error, string.Format(Strings.CONSOLE_LOG_COMMAND_FAILED, ex.Message));

            if (!RconClient.IsConnected)
            {
                LogService.Append(ConsoleLogLevel.Error, Strings.CONSOLE_LOG_CONNECTION_LOST);
            }
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("consoleHelpers.scrollToBottom", "console-output");
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    private static string GetEntryColor(ConsoleLogLevel level) => level switch
    {
        ConsoleLogLevel.Command  => "#569cd6",
        ConsoleLogLevel.Response => "#d4d4d4",
        ConsoleLogLevel.Error    => "#f44747",
        _                        => "#858585",
    };

    private static string FormatEntry(ConsoleLogEntry entry)
        => $"[{entry.Timestamp:HH:mm:ss}] {entry.Message}";

    public async ValueTask DisposeAsync()
    {
        RconClient.Connected -= OnConnectionChanged;
        RconClient.Disconnected -= OnConnectionChanged;
        _subscription?.Dispose();
        GC.SuppressFinalize(this);
        await Task.CompletedTask;
    }
}
