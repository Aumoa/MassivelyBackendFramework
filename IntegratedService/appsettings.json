{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Master": {
    "SlaveIdentifiers": {
      "GatewayId": "gateway-slave-id",
      "AuthId": "auth-slave-id"
    }
  },
  "Auth": {
    "Identifier": {
      "MasterUrl": "https://localhost:7268",
      "SlaveId": "auth-slave-id"
    },
    "AuthOptions": {
      "RedirectUrl": "https://localhost:7268",
      "ClientId": "your-client-id",
      "ClientSecret": "your-client-secret"
    },
    "JwtOptions": {
      "Issuer": "https://localhost:7268",
      "Audience": "https://localhost:7268",
      "SecretKey": "secret-key",
      "ExpireMinutes": 1440
    },
    "Accounts": {
      "Provider": "MySql",
      "ConnectionString": "Server=localhost;Port=3306;Database=MassivelyBackendFramework_Auth;Uid=root;Pwd=root;"
    },
    "Accesses": {
      "Provider": "MySql",
      "AccessTimeout": "24:00:00",
      "ConnectionString": "Server=localhost;Port=3306;Database=MassivelyBackendFramework_Auth;Uid=root;Pwd=root;"
    }
  }
}
