{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Master": {
    "SlaveIdentifiers": {
      "GatewayId": "gateway-slave-id",
      "AuthId": "auth-slave-id"
    }
  },
  "Gateway": {
    "Identifier": {
      "MasterUrl": "https://localhost:7268",
      "SlaveId": "gateway-slave-id"
    }
  },
  "Auth": {
    "Identifier": {
      "MasterUrl": "https://localhost:7268",
      "SlaveId": "auth-slave-id"
    },
    "AuthOptions": {
      "RedirectUrl": "https://localhost:7268",
      "ClientId": "your-client-id",
      "ClientSecret": "your-client-secret"
    },
    "JwtOptions": {
      "Issuer": "https://localhost:7268",
      "Audience": "https://localhost:7268",
      "SecretKey": "secret-key",
      "ExpireMinutes": 1440
    }
  }
}
