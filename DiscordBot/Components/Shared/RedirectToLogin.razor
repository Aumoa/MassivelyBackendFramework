@using OpenIDConnect
@inject NavigationManager Nav
@inject IAuthenticationStateProvider Auth

@code {
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Auth.NavigateToLogin(Nav, "auth/redirect", "openid profile email groups");
        }
        return base.OnAfterRenderAsync(firstRender);
    }
}
