@page "/channel-requests/{Token}"
@rendermode InteractiveServer
@using System.Globalization
@using DiscordBot.Repositories
@using DiscordBot.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@inject IAllowedChannelRequestService ChannelRequests
@inject AuthenticationStateProvider AuthState

<PageTitle>채널 승인 요청 - @Strings.APP_TITLE</PageTitle>

<div class="detail-toolbar">
    <a class="btn-ghost back-link" href="/channels" title="@Strings.ALLOWED_CHANNELS_BUTTON_BACK">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>@Strings.ALLOWED_CHANNELS_BUTTON_BACK</span>
    </a>
</div>

<div class="page-header">
    <h1 class="page-title">채널 승인 요청</h1>
    <p class="page-subtitle">Discord에서 생성된 채널 접근 요청을 확인하고 승인합니다.</p>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="status-message @statusKind">@statusMessage</div>
}

@if (isLoading)
{
    <p class="empty-state">@Strings.ALLOWED_CHANNELS_STATUS_LOADING</p>
}
else if (request is null)
{
    <p class="empty-state">승인 요청을 찾을 수 없습니다.</p>
}
else
{
    <section class="channel-detail-form">
        <dl class="metadata-list">
            <div>
                <dt>@Strings.ALLOWED_CHANNELS_LABEL_CHANNEL_ID</dt>
                <dd class="mono">@request.ChannelId</dd>
            </div>
            <div>
                <dt>@Strings.ALLOWED_CHANNELS_LABEL_GUILD_ID</dt>
                <dd class="mono">@request.GuildId</dd>
            </div>
            <div>
                <dt>@Strings.ALLOWED_CHANNELS_LABEL_CHANNEL_NAME</dt>
                <dd>@request.ChannelName</dd>
            </div>
            <div>
                <dt>@Strings.ALLOWED_CHANNELS_LABEL_GUILD_NAME</dt>
                <dd>@request.GuildName</dd>
            </div>
            <div>
                <dt>요청자</dt>
                <dd>@request.RequesterName (@request.RequesterId)</dd>
            </div>
            <div>
                <dt>상태</dt>
                <dd>@DisplayStatus(request)</dd>
            </div>
            <div>
                <dt>@Strings.ALLOWED_CHANNELS_LABEL_CREATED_AT</dt>
                <dd>@DisplayDate(request.CreatedAt)</dd>
            </div>
            <div>
                <dt>만료 시간</dt>
                <dd>@DisplayDate(request.ExpiresAt)</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(request.ApprovedBy))
            {
                <div>
                    <dt>승인자</dt>
                    <dd>@request.ApprovedBy</dd>
                </div>
            }
        </dl>

        <div class="form-actions">
            <button class="btn-primary" type="button" disabled="@(!CanApprove || isBusy)" @onclick="ApproveAsync">
                <span class="material-symbols-outlined">check_circle</span>
                승인
            </button>
            @if (approvedChannel is not null)
            {
                <a class="btn-ghost" href="@($"/channels/{approvedChannel.Id}")">
                    <span class="material-symbols-outlined">open_in_new</span>
                    채널 설정 열기
                </a>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private AllowedChannelRequestData? request;
    private AllowedChannelData? approvedChannel;
    private bool isLoading = true;
    private bool isBusy;
    private string? statusMessage;
    private string statusKind = "success";

    private bool CanApprove =>
        request is { Status: "pending" }
        && request.ExpiresAt > DateTime.UtcNow;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        approvedChannel = null;
        try
        {
            request = await ChannelRequests.GetAsync(Token);
        }
        catch
        {
            SetStatus("error", "승인 요청을 불러오지 못했습니다.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApproveAsync()
    {
        if (!CanApprove || isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            approvedChannel = await ChannelRequests.ApproveAsync(Token, await GetCurrentUserAsync());
            request = await ChannelRequests.GetAsync(Token);
            SetStatus("success", "채널을 승인했습니다.");
        }
        catch (Exception e)
        {
            SetStatus("error", e.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task<string?> GetCurrentUserAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        return auth.User.FindFirst("sub")?.Value
            ?? auth.User.FindFirst("name")?.Value
            ?? auth.User.Identity?.Name;
    }

    private static string DisplayStatus(AllowedChannelRequestData data)
    {
        if (data.Status == "pending" && data.ExpiresAt <= DateTime.UtcNow)
        {
            return "만료됨";
        }

        return data.Status switch
        {
            "pending" => "승인 대기",
            "approved" => "승인됨",
            _ => data.Status
        };
    }

    private static string DisplayDate(DateTime value)
    {
        return value.ToLocalTime().ToString("G", CultureInfo.CurrentCulture);
    }

    private void SetStatus(string kind, string message)
    {
        statusKind = kind;
        statusMessage = message;
    }
}
