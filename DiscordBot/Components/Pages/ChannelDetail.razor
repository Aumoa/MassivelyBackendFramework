@page "/channels/{Id:long}"
@rendermode InteractiveServer
@using System.Globalization
@using DiscordBot.Repositories
@using DiscordBot.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@inject IAllowedChannelService ChannelAccess
@inject NavigationManager Navigation

<PageTitle>@Strings.ALLOWED_CHANNELS_DETAIL_TITLE - @Strings.APP_TITLE</PageTitle>

<div class="detail-toolbar">
    <a class="btn-ghost back-link" href="/channels" title="@Strings.ALLOWED_CHANNELS_BUTTON_BACK">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>@Strings.ALLOWED_CHANNELS_BUTTON_BACK</span>
    </a>
</div>

<div class="page-header">
    <h1 class="page-title">@Strings.ALLOWED_CHANNELS_DETAIL_TITLE</h1>
    <p class="page-subtitle">@Strings.ALLOWED_CHANNELS_DETAIL_SUBTITLE</p>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="status-message @statusKind">@statusMessage</div>
}

@if (isLoading)
{
    <p class="empty-state">@Strings.ALLOWED_CHANNELS_STATUS_LOADING</p>
}
else if (form is null && !loadFailed)
{
    <p class="empty-state">@Strings.ALLOWED_CHANNELS_STATUS_NOT_FOUND</p>
}
else if (form is not null)
{
    <form class="channel-detail-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <label>
            <span>@Strings.ALLOWED_CHANNELS_LABEL_CHANNEL_ID</span>
            <input class="mono" @bind="form.ChannelId" disabled="@isBusy" required maxlength="64" />
        </label>
        <label>
            <span>@Strings.ALLOWED_CHANNELS_LABEL_GUILD_ID</span>
            <input class="mono" @bind="form.GuildId" disabled="@isBusy" maxlength="64" />
        </label>
        <label>
            <span>@Strings.ALLOWED_CHANNELS_LABEL_CHANNEL_NAME</span>
            <input @bind="form.ChannelName" disabled="@isBusy" maxlength="128" />
        </label>
        <label>
            <span>@Strings.ALLOWED_CHANNELS_LABEL_GUILD_NAME</span>
            <input @bind="form.GuildName" disabled="@isBusy" maxlength="128" />
        </label>
        <label class="memo-field">
            <span>@Strings.ALLOWED_CHANNELS_LABEL_MEMO</span>
            <textarea @bind="form.Memo" disabled="@isBusy" maxlength="512"></textarea>
        </label>
        <label class="enabled-field">
            <input type="checkbox" @bind="form.Enabled" disabled="@isBusy" />
            <span>@Strings.ALLOWED_CHANNELS_LABEL_ENABLED</span>
        </label>

        <dl class="metadata-list">
            <div>
                <dt>@Strings.ALLOWED_CHANNELS_LABEL_CREATED_BY</dt>
                <dd>@channel?.CreatedBy</dd>
            </div>
            <div>
                <dt>@Strings.ALLOWED_CHANNELS_LABEL_CREATED_AT</dt>
                <dd>@DisplayDate(channel?.CreatedAt)</dd>
            </div>
            <div>
                <dt>@Strings.ALLOWED_CHANNELS_LABEL_UPDATED_AT</dt>
                <dd>@DisplayDate(channel?.UpdatedAt)</dd>
            </div>
        </dl>

        <div class="form-actions">
            <button class="btn-primary" type="submit" disabled="@isBusy">
                <span class="material-symbols-outlined">save</span>
                @Strings.ALLOWED_CHANNELS_BUTTON_SAVE
            </button>
            <button class="btn-danger" type="button" disabled="@isBusy" @onclick="DeleteAsync">
                <span class="material-symbols-outlined">delete</span>
                @Strings.ALLOWED_CHANNELS_BUTTON_DELETE
            </button>
        </div>
    </form>
}

@code {
    [Parameter]
    public long Id { get; set; }

    private AllowedChannelData? channel;
    private ChannelForm? form;
    private bool isLoading = true;
    private bool isBusy;
    private bool loadFailed;
    private string? statusMessage;
    private string statusKind = "success";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;
        try
        {
            channel = await ChannelAccess.GetAsync(Id);
            form = channel is null ? null : ChannelForm.From(channel);
        }
        catch
        {
            loadFailed = true;
            form = null;
            SetStatus("error", Strings.ALLOWED_CHANNELS_ERROR_LOAD_FAILED);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (isBusy || form is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(form.ChannelId))
        {
            SetStatus("error", Strings.ALLOWED_CHANNELS_ERROR_CHANNEL_ID_REQUIRED);
            return;
        }

        isBusy = true;
        try
        {
            await ChannelAccess.UpdateAsync(
                Id,
                form.ChannelId,
                form.GuildId,
                form.ChannelName,
                form.GuildName,
                form.Memo,
                form.Enabled);
            await LoadAsync();
            SetStatus("success", Strings.ALLOWED_CHANNELS_STATUS_SAVED);
        }
        catch
        {
            SetStatus("error", Strings.ALLOWED_CHANNELS_ERROR_SAVE_FAILED);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            await ChannelAccess.DeleteAsync(Id);
            Navigation.NavigateTo("/channels");
        }
        catch
        {
            SetStatus("error", Strings.ALLOWED_CHANNELS_ERROR_ACTION_FAILED);
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string DisplayDate(DateTime? value)
    {
        return value?.ToLocalTime().ToString("G", CultureInfo.CurrentCulture) ?? string.Empty;
    }

    private void SetStatus(string kind, string message)
    {
        statusKind = kind;
        statusMessage = message;
    }

    private sealed class ChannelForm
    {
        public string ChannelId { get; set; } = string.Empty;
        public string? GuildId { get; set; }
        public string? ChannelName { get; set; }
        public string? GuildName { get; set; }
        public string? Memo { get; set; }
        public bool Enabled { get; set; }

        public static ChannelForm From(AllowedChannelData data)
        {
            return new ChannelForm
            {
                ChannelId = data.ChannelId,
                GuildId = data.GuildId,
                ChannelName = data.ChannelName,
                GuildName = data.GuildName,
                Memo = data.Memo,
                Enabled = data.Enabled
            };
        }
    }
}
