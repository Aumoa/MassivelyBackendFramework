@page "/"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthState

<PageTitle>@Strings.HOME_TITLE — @Strings.APP_TITLE</PageTitle>

<div class="page-header">
    <h1 class="page-title">@Strings.HOME_TITLE</h1>
    <p class="page-subtitle">@Strings.HOME_SUBTITLE</p>
</div>

@if (!string.IsNullOrEmpty(userName))
{
    <p>@string.Format(Strings.HOME_WELCOME, userName)</p>
}

@code {
    private string userName = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var auth = await AuthState.GetAuthenticationStateAsync();
        userName = auth.User.FindFirst("name")?.Value ?? string.Empty;
        StateHasChanged();
    }
}
