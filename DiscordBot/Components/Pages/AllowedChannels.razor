@page "/allowed-channels"
@rendermode InteractiveServer
@using DiscordBot.Repositories
@using DiscordBot.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@inject IAllowedChannelService ChannelAccess
@inject AuthenticationStateProvider AuthState

<PageTitle>@Strings.ALLOWED_CHANNELS_TITLE — @Strings.APP_TITLE</PageTitle>

<div class="page-header">
    <h1 class="page-title">@Strings.ALLOWED_CHANNELS_TITLE</h1>
    <p class="page-subtitle">@Strings.ALLOWED_CHANNELS_SUBTITLE</p>
</div>

<form class="channel-form" @onsubmit="AddChannelAsync" @onsubmit:preventDefault>
    <label>
        <span>@Strings.ALLOWED_CHANNELS_LABEL_CHANNEL_ID</span>
        <input class="mono" @bind="newChannel.ChannelId" disabled="@isBusy" required maxlength="64" />
    </label>
    <label>
        <span>@Strings.ALLOWED_CHANNELS_LABEL_GUILD_ID</span>
        <input class="mono" @bind="newChannel.GuildId" disabled="@isBusy" maxlength="64" />
    </label>
    <label>
        <span>@Strings.ALLOWED_CHANNELS_LABEL_CHANNEL_NAME</span>
        <input @bind="newChannel.ChannelName" disabled="@isBusy" maxlength="128" />
    </label>
    <label>
        <span>@Strings.ALLOWED_CHANNELS_LABEL_GUILD_NAME</span>
        <input @bind="newChannel.GuildName" disabled="@isBusy" maxlength="128" />
    </label>
    <label class="memo-field">
        <span>@Strings.ALLOWED_CHANNELS_LABEL_MEMO</span>
        <input @bind="newChannel.Memo" disabled="@isBusy" maxlength="512" />
    </label>
    <label class="enabled-field">
        <input type="checkbox" @bind="newChannel.Enabled" disabled="@isBusy" />
        <span>@Strings.ALLOWED_CHANNELS_LABEL_ENABLED</span>
    </label>
    <button class="btn-primary add-button" type="submit" disabled="@isBusy">
        <span class="material-symbols-outlined">add</span>
        @Strings.ALLOWED_CHANNELS_BUTTON_ADD
    </button>
</form>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="status-message @statusKind">@statusMessage</div>
}

@if (isLoading)
{
    <p class="empty-state">@Strings.ALLOWED_CHANNELS_STATUS_LOADING</p>
}
else if (channels.Count == 0)
{
    <p class="empty-state">@Strings.ALLOWED_CHANNELS_EMPTY</p>
}
else
{
    <div class="channel-table-wrap">
        <table class="channel-table">
            <thead>
                <tr>
                    <th>@Strings.ALLOWED_CHANNELS_LABEL_CHANNEL_ID</th>
                    <th>@Strings.ALLOWED_CHANNELS_LABEL_GUILD_ID</th>
                    <th>@Strings.ALLOWED_CHANNELS_LABEL_CHANNEL_NAME</th>
                    <th>@Strings.ALLOWED_CHANNELS_LABEL_GUILD_NAME</th>
                    <th>@Strings.ALLOWED_CHANNELS_LABEL_MEMO</th>
                    <th>@Strings.ALLOWED_CHANNELS_LABEL_ENABLED</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var channel in channels)
                {
                    <tr @key="channel.Id">
                        <td>
                            <input class="mono" @bind="channel.ChannelId" disabled="@channel.IsBusy" maxlength="64" />
                        </td>
                        <td>
                            <input class="mono" @bind="channel.GuildId" disabled="@channel.IsBusy" maxlength="64" />
                        </td>
                        <td>
                            <input @bind="channel.ChannelName" disabled="@channel.IsBusy" maxlength="128" />
                        </td>
                        <td>
                            <input @bind="channel.GuildName" disabled="@channel.IsBusy" maxlength="128" />
                        </td>
                        <td>
                            <input @bind="channel.Memo" disabled="@channel.IsBusy" maxlength="512" />
                        </td>
                        <td>
                            <label class="row-toggle">
                                <input
                                    type="checkbox"
                                    checked="@channel.Enabled"
                                    disabled="@channel.IsBusy"
                                    @onchange="e => SetEnabledAsync(channel, e.Value is bool enabled && enabled)" />
                                <span>@(channel.Enabled ? Strings.ALLOWED_CHANNELS_LABEL_ENABLED : Strings.ALLOWED_CHANNELS_LABEL_DISABLED)</span>
                            </label>
                        </td>
                        <td>
                            <div class="row-actions">
                                <button class="btn-ghost" type="button" disabled="@channel.IsBusy" @onclick="() => SaveAsync(channel)">
                                    <span class="material-symbols-outlined">save</span>
                                </button>
                                <button class="btn-danger" type="button" disabled="@channel.IsBusy" @onclick="() => DeleteAsync(channel)">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly ChannelForm newChannel = new();
    private List<ChannelRow> channels = [];
    private bool isLoading = true;
    private bool isBusy;
    private string? statusMessage;
    private string statusKind = "success";

    protected override async Task OnInitializedAsync()
    {
        newChannel.Enabled = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var data = await ChannelAccess.GetAllAsync();
            channels = data.Select(ChannelRow.From).ToList();
        }
        catch
        {
            SetStatus("error", Strings.ALLOWED_CHANNELS_ERROR_LOAD_FAILED);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddChannelAsync()
    {
        if (isBusy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(newChannel.ChannelId))
        {
            SetStatus("error", Strings.ALLOWED_CHANNELS_ERROR_CHANNEL_ID_REQUIRED);
            return;
        }

        isBusy = true;
        try
        {
            await ChannelAccess.AddAsync(
                newChannel.ChannelId,
                newChannel.GuildId,
                newChannel.ChannelName,
                newChannel.GuildName,
                newChannel.Memo,
                newChannel.Enabled,
                await GetCurrentUserAsync());

            newChannel.Clear();
            SetStatus("success", Strings.ALLOWED_CHANNELS_STATUS_ADDED);
            await LoadAsync();
        }
        catch
        {
            SetStatus("error", Strings.ALLOWED_CHANNELS_ERROR_SAVE_FAILED);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveAsync(ChannelRow channel)
    {
        await RunRowActionAsync(channel, async () =>
        {
            await ChannelAccess.UpdateAsync(
                channel.Id,
                channel.ChannelId,
                channel.GuildId,
                channel.ChannelName,
                channel.GuildName,
                channel.Memo,
                channel.Enabled);
            SetStatus("success", Strings.ALLOWED_CHANNELS_STATUS_SAVED);
            await LoadAsync();
        });
    }

    private async Task SetEnabledAsync(ChannelRow channel, bool enabled)
    {
        await RunRowActionAsync(channel, async () =>
        {
            await ChannelAccess.SetEnabledAsync(channel.Id, enabled);
            channel.Enabled = enabled;
            SetStatus("success", enabled ? Strings.ALLOWED_CHANNELS_STATUS_ENABLED : Strings.ALLOWED_CHANNELS_STATUS_DISABLED);
        });
    }

    private async Task DeleteAsync(ChannelRow channel)
    {
        await RunRowActionAsync(channel, async () =>
        {
            await ChannelAccess.DeleteAsync(channel.Id);
            channels.Remove(channel);
            SetStatus("success", Strings.ALLOWED_CHANNELS_STATUS_DELETED);
        });
    }

    private async Task RunRowActionAsync(ChannelRow channel, Func<Task> action)
    {
        if (channel.IsBusy)
        {
            return;
        }

        channel.IsBusy = true;
        try
        {
            await action();
        }
        catch
        {
            SetStatus("error", Strings.ALLOWED_CHANNELS_ERROR_ACTION_FAILED);
        }
        finally
        {
            channel.IsBusy = false;
        }
    }

    private async Task<string?> GetCurrentUserAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        return auth.User.FindFirst("sub")?.Value
            ?? auth.User.FindFirst("name")?.Value
            ?? auth.User.Identity?.Name;
    }

    private void SetStatus(string kind, string message)
    {
        statusKind = kind;
        statusMessage = message;
    }

    private class ChannelForm
    {
        public string ChannelId { get; set; } = string.Empty;
        public string? GuildId { get; set; }
        public string? ChannelName { get; set; }
        public string? GuildName { get; set; }
        public string? Memo { get; set; }
        public bool Enabled { get; set; } = true;

        public void Clear()
        {
            ChannelId = string.Empty;
            GuildId = null;
            ChannelName = null;
            GuildName = null;
            Memo = null;
            Enabled = true;
        }
    }

    private sealed class ChannelRow : ChannelForm
    {
        public long Id { get; init; }
        public bool IsBusy { get; set; }

        public static ChannelRow From(AllowedChannelData data)
        {
            return new ChannelRow
            {
                Id = data.Id,
                ChannelId = data.ChannelId,
                GuildId = data.GuildId,
                ChannelName = data.ChannelName,
                GuildName = data.GuildName,
                Memo = data.Memo,
                Enabled = data.Enabled
            };
        }
    }
}
