@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing

<AuthorizeView Roles="admin">
    <Authorized>
        <div class="bot-shell">
            <header class="bot-topbar">
                <a class="bot-topbar-brand" href="/">@Strings.APP_TITLE</a>

                <nav class="bot-topbar-nav">
                    <NavLink class="bot-nav-link" href="/" Match="NavLinkMatch.All">
                        <span class="material-symbols-outlined">home</span>
                        @Strings.NAVMENU_LABEL_HOME
                    </NavLink>
                    <NavLink class="bot-nav-link" href="/allowed-channels">
                        <span class="material-symbols-outlined">tag</span>
                        <span>@Strings.NAVMENU_LABEL_CHANNELS</span>
                    </NavLink>
                </nav>

                <div class="bot-topbar-end">
                    <ProfileCard />
                </div>
            </header>

            <main class="bot-main">
                @Body
            </main>
        </div>

        <div id="blazor-error-ui">
            @Strings.ERROR_UNHANDLED
            <a href="" class="reload">@Strings.ERROR_RELOAD</a>
            <span class="dismiss">✕</span>
        </div>
    </Authorized>
    <NotAuthorized Context="notAuthContext">
        @if (notAuthContext.User.Identity?.IsAuthenticated == true)
        {
            <AccessDenied />
        }
        else
        {
            <RedirectToLogin />
        }
    </NotAuthorized>
</AuthorizeView>
