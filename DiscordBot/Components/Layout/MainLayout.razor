@inherits LayoutComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing

<AuthorizeView Roles="admin">
    <Authorized>
        <div class="bot-shell">
            <header class="bot-topbar">
                <a class="bot-topbar-brand" href="/">@Strings.APP_TITLE</a>

                <nav class="bot-topbar-nav">
                    <NavLink class="bot-nav-link" href="/" Match="NavLinkMatch.All">
                        <span class="material-symbols-outlined">home</span>
                        @Strings.NAVMENU_LABEL_HOME
                    </NavLink>
                    <NavLink class="bot-nav-link" href="/tools">
                        <span class="material-symbols-outlined">extension</span>
                        <span>@Strings.NAVMENU_LABEL_TOOLS</span>
                    </NavLink>
                    <NavLink class="bot-nav-link" href="/ai-skills">
                        <span class="material-symbols-outlined">psychology</span>
                        <span>@T("NAVMENU_LABEL_AI_SKILLS")</span>
                    </NavLink>
                    <NavLink class="bot-nav-link" href="/server-logs">
                        <span class="material-symbols-outlined">article</span>
                        <span>@T("NAVMENU_LABEL_SERVER_LOGS")</span>
                    </NavLink>
                    <NavLink class="bot-nav-link" href="/claude-settings">
                        <span class="material-symbols-outlined">tune</span>
                        <span>@Strings.NAVMENU_LABEL_CLAUDE_SETTINGS</span>
                    </NavLink>
                </nav>

                <div class="bot-topbar-end">
                    <ProfileCard />
                </div>
            </header>

            <main class="bot-main">
                @Body
            </main>
        </div>

        <div id="blazor-error-ui">
            @Strings.ERROR_UNHANDLED
            <a href="" class="reload">@Strings.ERROR_RELOAD</a>
            <span class="dismiss">✕</span>
        </div>
    </Authorized>
    <NotAuthorized Context="notAuthContext">
        @if (notAuthContext.User.Identity?.IsAuthenticated == true)
        {
            <AccessDenied />
        }
        else
        {
            <RedirectToLogin />
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string T(string key)
    {
        return Strings.ResourceManager.GetString(key, CultureInfo.CurrentUICulture) ?? key;
    }
}
