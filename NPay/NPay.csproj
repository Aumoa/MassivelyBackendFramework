<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.8" />
	<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.9" />
	<PackageReference Include="StackExchange.Redis" Version="2.9.25" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\AICommon\AICommon.csproj" />
	<ProjectReference Include="..\BlazorSharedComponent\BlazorSharedComponent.csproj" />
	<ProjectReference Include="..\OAuth2.Abstractions\OAuth2.Abstractions.csproj" />
	<ProjectReference Include="..\OpenIDConnect.Core\OpenIDConnect.Core.csproj" />
	<ProjectReference Include="..\NPay.Core\NPay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Compile Update="Localizations\Strings.Designer.cs">
	  <DesignTime>True</DesignTime>
	  <AutoGen>True</AutoGen>
	  <DependentUpon>Strings.resx</DependentUpon>
	</Compile>
  </ItemGroup>

  <ItemGroup>
	<EmbeddedResource Update="Localizations\Strings.resx">
	  <Generator>ResXFileCodeGenerator</Generator>
	  <LastGenOutput>Strings.Designer.cs</LastGenOutput>
	</EmbeddedResource>
  </ItemGroup>

</Project>
