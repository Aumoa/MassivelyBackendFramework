@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu Title="@Strings.APP_TITLE" Items="Items" />
            </div>

            <main>
                <div class="top-row px-4">
                    <div class="ms-auto d-flex align-items-center">
                        <ProfileCard />
                    </div>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui">
            @Strings.ERROR_UNHANDLED
            <a href="" class="reload">@Strings.ERROR_RELOAD</a>
            <a class="dismiss">🗙</a>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly NavMenu.NavMenuItem[] Items =
    [
        new(Strings.NAVMENU_LABEL_HOME, "home", "/", true),
        new(Strings.NAVMENU_LABEL_SETTLEMENTS, "receipt_long", "/settlements", false),
    ];
}
