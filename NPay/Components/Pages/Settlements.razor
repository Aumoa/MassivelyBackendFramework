@page "/settlements"
@rendermode InteractiveServer
@using NPay.Models
@using NPay.Services
@inject ISettlementService SettlementService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@Strings.SETTLEMENTS_TITLE — @Strings.APP_TITLE</PageTitle>

<div class="page-header">
    <div class="page-header-row">
        <div>
            <h1 class="page-title">@Strings.SETTLEMENTS_TITLE</h1>
            <p class="page-subtitle">@Strings.SETTLEMENTS_SUBTITLE</p>
        </div>
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/settlements/new")'>
            <span class="material-symbols-outlined" style="font-size:16px;">add</span>
            @Strings.SETTLEMENTS_BUTTON_NEW
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="settlement-list">
        @for (int i = 0; i < 3; i++)
        {
            <div class="settlement-row">
                <div class="settlement-row-title">
                    <span class="skeleton" style="width:180px;"></span>
                </div>
            </div>
        }
    </div>
}
else if (settlements.Count == 0)
{
    <div class="empty-state">
        <span class="material-symbols-outlined">receipt_long</span>
        <p>@Strings.SETTLEMENTS_EMPTY</p>
    </div>
}
else
{
    <div class="settlement-list">
        @foreach (var s in settlements)
        {
            <div class="settlement-row">
                <div class="settlement-row-title">
                    <button class="settlement-row-name" @onclick="() => OpenDetail(s.Id)">@s.Title</button>
                    @if (!string.IsNullOrWhiteSpace(s.Description))
                    {
                        <div class="settlement-row-desc">@s.Description</div>
                    }
                </div>

                <div class="settlement-row-meta">
                    @if (s.Status == SettlementStatus.Open)
                    {
                        <span class="badge badge-open">@Strings.SETTLEMENTS_STATUS_OPEN</span>
                    }
                    else
                    {
                        <span class="badge badge-closed">@Strings.SETTLEMENTS_STATUS_CLOSED</span>
                    }
                    <span class="settlement-row-date">@s.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd")</span>
                </div>

                <div class="settlement-row-actions">
                    <button class="btn-ghost" style="padding:4px 10px;font-size:0.8rem;" @onclick="() => OpenDetail(s.Id)">
                        @Strings.SETTLEMENTS_BUTTON_OPEN
                    </button>
                    <button class="btn-danger" @onclick="() => DeleteAsync(s.Id)">
                        @Strings.SETTLEMENTS_BUTTON_DELETE
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool isLoading = true;
    private List<Settlement> settlements = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        StateHasChanged();

        var auth = await AuthState.GetAuthenticationStateAsync();
        var subject = auth.User.FindFirst("sub")?.Value ?? string.Empty;
        settlements = [.. await SettlementService.GetSettlementsAsync(subject)];
        isLoading = false;
        StateHasChanged();
    }

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/settlements/{id}");

    private async Task DeleteAsync(Guid id)
    {
        await SettlementService.DeleteSettlementAsync(id);
        await LoadAsync();
    }
}

