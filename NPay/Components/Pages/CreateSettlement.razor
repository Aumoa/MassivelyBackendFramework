@page "/settlements/new"
@rendermode InteractiveServer
@using NPay.Services
@inject ISettlementService SettlementService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@Strings.CREATE_SETTLEMENT_TITLE — @Strings.APP_TITLE</PageTitle>

<div class="page-header">
    <h1 class="page-title">@Strings.CREATE_SETTLEMENT_TITLE</h1>
    <p class="page-subtitle">@Strings.CREATE_SETTLEMENT_SUBTITLE</p>
</div>

<div style="max-width:480px;">
    <div class="form-group">
        <label class="form-label">@Strings.CREATE_SETTLEMENT_LABEL_TITLE</label>
        <input class="form-input" @bind="title" placeholder="@Strings.CREATE_SETTLEMENT_PLACEHOLDER_TITLE" maxlength="100" />
    </div>
    <div class="form-group">
        <label class="form-label">@Strings.CREATE_SETTLEMENT_LABEL_DESC</label>
        <textarea class="form-textarea" @bind="description" rows="3" placeholder="@Strings.CREATE_SETTLEMENT_PLACEHOLDER_DESC" maxlength="300"></textarea>
    </div>
    <div class="form-group">
        <label style="display:flex;align-items:center;gap:var(--space-2);cursor:pointer;user-select:none;">
            <input type="checkbox" @bind="allowGuestExpenseEdit"
                   style="width:16px;height:16px;accent-color:var(--color-accent);cursor:pointer;" />
            <span style="font-size:var(--text-sm);color:var(--color-text-primary);">@Strings.CREATE_SETTLEMENT_LABEL_GUEST_EDIT</span>
        </label>
        <div style="font-size:var(--text-xs);color:var(--color-text-muted);margin-top:var(--space-1);margin-left:24px;">
            @Strings.CREATE_SETTLEMENT_HINT_GUEST_EDIT
        </div>
    </div>
    <div style="display:flex;gap:var(--space-3);">
        <button class="btn-primary" @onclick="CreateAsync" disabled="@(isBusy || string.IsNullOrWhiteSpace(title))">
            @Strings.CREATE_SETTLEMENT_BUTTON_CREATE
        </button>
        <button class="btn-ghost" @onclick='() => Nav.NavigateTo("/settlements")' disabled="@isBusy">
            @Strings.CREATE_SETTLEMENT_BUTTON_CANCEL
        </button>
    </div>
</div>

@code {
    private string title = string.Empty;
    private string? description;
    private bool allowGuestExpenseEdit = true;
    private bool isBusy;

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(title)) return;
        isBusy = true;

        var auth = await AuthState.GetAuthenticationStateAsync();
        var subject = auth.User.FindFirst("sub")?.Value ?? string.Empty;
        var settlement = await SettlementService.CreateSettlementAsync(subject, title.Trim(), description?.Trim(), allowGuestExpenseEdit);
        Nav.NavigateTo($"/settlements/{settlement.Id}");
    }
}
