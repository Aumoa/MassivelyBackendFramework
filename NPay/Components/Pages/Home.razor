@page "/"
@rendermode InteractiveServer
@using NPay.Models
@using NPay.Services
@inject ISettlementService SettlementService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@Strings.HOME_TITLE — @Strings.APP_TITLE</PageTitle>

<div class="page-header">
    <h1>@Strings.HOME_TITLE</h1>
    <p>@Strings.HOME_SUBTITLE</p>
</div>

<div class="quick-cards">
    <div class="quick-card npay-card-hover" @onclick='() => Nav.NavigateTo("/settlements")' style="cursor:pointer;">
        <span class="material-symbols-outlined" style="color:var(--color-accent);font-size:2rem;">receipt_long</span>
        <div>
            <div style="font-weight:600;font-size:var(--text-base);color:var(--color-text-primary);margin-bottom:var(--space-1);">@Strings.HOME_CARD_SETTLEMENTS_TITLE</div>
            <p style="margin:0;font-size:var(--text-sm);">@Strings.HOME_CARD_SETTLEMENTS_DESC</p>
        </div>
        @if (isLoading)
        {
            <span class="skeleton" style="width:120px;height:1rem;"></span>
        }
        else
        {
            <div style="font-size:var(--text-sm);font-weight:600;color:var(--color-accent);">
                @openCount @(openCount == 1 ? "active settlement" : "active settlements")
            </div>
        }
        <button class="btn-primary" style="align-self:flex-start;" @onclick='() => Nav.NavigateTo("/settlements")'>
            @Strings.HOME_CARD_SETTLEMENTS_BUTTON
        </button>
    </div>

    <div class="quick-card npay-card-hover" @onclick='() => Nav.NavigateTo("/settlements/new")' style="cursor:pointer;">
        <span class="material-symbols-outlined" style="color:var(--color-accent);font-size:2rem;">add_circle</span>
        <div>
            <div style="font-weight:600;font-size:var(--text-base);color:var(--color-text-primary);margin-bottom:var(--space-1);">@Strings.HOME_CARD_CREATE_TITLE</div>
            <p style="margin:0;font-size:var(--text-sm);">@Strings.HOME_CARD_CREATE_DESC</p>
        </div>
        <button class="btn-primary" style="align-self:flex-start;" @onclick='() => Nav.NavigateTo("/settlements/new")'>
            @Strings.HOME_CARD_CREATE_BUTTON
        </button>
    </div>
</div>

@code {
    private bool isLoading = true;
    private int openCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var auth = await AuthState.GetAuthenticationStateAsync();
        var subject = auth.User.FindFirst("sub")?.Value ?? string.Empty;
        var settlements = await SettlementService.GetSettlementsAsync(subject);
        openCount = settlements.Count(s => s.Status == SettlementStatus.Open);
        isLoading = false;
        StateHasChanged();
    }
}
