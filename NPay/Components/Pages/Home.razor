@page "/"
@rendermode InteractiveServer
@using NPay.Models
@using NPay.Services
@inject ISettlementService SettlementService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@Strings.HOME_TITLE — @Strings.APP_TITLE</PageTitle>

<div class="page-header">
    <h1 class="page-title">@Strings.HOME_TITLE</h1>
    <p class="page-subtitle">@Strings.HOME_SUBTITLE</p>
</div>

@if (isLoading)
{
    <div class="quick-cards">
        <div class="quick-card">
            <div class="quick-card-icon"><span class="material-symbols-outlined">receipt_long</span></div>
            <p class="quick-card-title"><span class="skeleton skeleton-text"></span></p>
        </div>
        <div class="quick-card">
            <div class="quick-card-icon"><span class="material-symbols-outlined">add_circle</span></div>
            <p class="quick-card-title"><span class="skeleton skeleton-text"></span></p>
        </div>
    </div>
}
else
{
    <div class="quick-cards">
        <div class="quick-card npay-card-hover" @onclick='() => Nav.NavigateTo("/settlements")' style="cursor:pointer">
            <div class="quick-card-icon">
                <span class="material-symbols-outlined">receipt_long</span>
            </div>
            <p class="quick-card-title">@Strings.HOME_CARD_SETTLEMENTS_TITLE</p>
            <p class="quick-card-desc">@Strings.HOME_CARD_SETTLEMENTS_DESC</p>
            <div class="stat-value" style="font-size:1.5rem;">@openCount</div>
            <p class="stat-label">@(openCount == 1 ? "active settlement" : "active settlements")</p>
            <button class="btn-ghost" style="align-self:flex-start;margin-top:auto;">
                @Strings.HOME_CARD_SETTLEMENTS_BUTTON
                <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
            </button>
        </div>

        <div class="quick-card npay-card-hover" @onclick='() => Nav.NavigateTo("/settlements/new")' style="cursor:pointer">
            <div class="quick-card-icon">
                <span class="material-symbols-outlined">add_circle</span>
            </div>
            <p class="quick-card-title">@Strings.HOME_CARD_CREATE_TITLE</p>
            <p class="quick-card-desc">@Strings.HOME_CARD_CREATE_DESC</p>
            <button class="btn-primary" style="align-self:flex-start;margin-top:auto;">
                @Strings.HOME_CARD_CREATE_BUTTON
            </button>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private int openCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var auth = await AuthState.GetAuthenticationStateAsync();
        var subject = auth.User.FindFirst("sub")?.Value ?? string.Empty;
        var settlements = await SettlementService.GetSettlementsAsync(subject);
        openCount = settlements.Count(s => s.Status == SettlementStatus.Open);
        isLoading = false;
        StateHasChanged();
    }
}

