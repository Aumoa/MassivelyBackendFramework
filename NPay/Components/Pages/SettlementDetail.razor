@page "/settlements/{Id:guid}"
@layout PublicLayout
@rendermode InteractiveServer
@using NPay.Models
@using NPay.Services
@inject ISettlementService SettlementService
@inject IParticipantService ParticipantService
@inject IExpenseService ExpenseService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@(settlement?.Title ?? Strings.LOADING) — @Strings.APP_TITLE</PageTitle>

@if (isLoading)
{
    <div class="page-header">
        <span class="skeleton" style="width:240px;height:1.75rem;"></span>
    </div>
}
else if (settlement is null)
{
    <div class="alert-info">@Strings.SETTLEMENT_DETAIL_NOT_FOUND</div>
}
else
{
    <div class="page-header">
        <div class="page-header-row">
            <div>
                <h1 class="page-title">@settlement.Title</h1>
                @if (!string.IsNullOrWhiteSpace(settlement.Description))
                {
                    <p class="page-subtitle">@settlement.Description</p>
                }
            </div>
            @if (settlement.Status == SettlementStatus.Open)
            {
                @if (isOwner)
                {
                    <button class="btn-ghost" @onclick="CloseSettlementAsync">
                        <span class="material-symbols-outlined" style="font-size:16px;">lock</span>
                        @Strings.SETTLEMENT_DETAIL_BUTTON_CLOSE
                    </button>
                }
                else
                {
                    <span class="badge badge-open">@Strings.SETTLEMENTS_STATUS_OPEN</span>
                }
            }
            else
            {
                <span class="badge badge-closed">@Strings.SETTLEMENTS_STATUS_CLOSED</span>
            }
        </div>
    </div>

    <!-- Tabs -->
    <div class="npay-tabs">
        <button class="npay-tab @(activeTab == Tab.Expenses ? "active" : "")" @onclick="() => activeTab = Tab.Expenses">
            @Strings.SETTLEMENT_DETAIL_TAB_EXPENSES
        </button>
        <button class="npay-tab @(activeTab == Tab.Participants ? "active" : "")" @onclick="() => activeTab = Tab.Participants">
            @Strings.SETTLEMENT_DETAIL_TAB_PARTICIPANTS
        </button>
        <button class="npay-tab @(activeTab == Tab.Result ? "active" : "")" @onclick="() => activeTab = Tab.Result">
            @Strings.SETTLEMENT_DETAIL_TAB_RESULT
        </button>
    </div>

    <!-- Expenses Tab -->
    @if (activeTab == Tab.Expenses)
    {
        @if (settlement.Status == SettlementStatus.Open && settlement.Participants.Count > 0 && isOwner)
        {
            <div class="inline-form" style="flex-wrap:wrap;">
                <div class="inline-form-field" style="flex:2;min-width:140px;">
                    <label class="inline-form-label">@Strings.SETTLEMENT_DETAIL_EXPENSE_LABEL</label>
                    <input class="form-input" @bind="newExpenseLabel" placeholder="e.g. Beer" maxlength="100" />
                </div>
                <div class="inline-form-field" style="flex:1;min-width:100px;">
                    <label class="inline-form-label">@Strings.SETTLEMENT_DETAIL_EXPENSE_AMOUNT</label>
                    <input class="form-input" type="number" min="1" @bind="newExpenseAmount" />
                </div>
                <div class="inline-form-field" style="flex:2;min-width:140px;">
                    <label class="inline-form-label">@Strings.SETTLEMENT_DETAIL_EXPENSE_PAID_BY</label>
                    <select class="form-select" @bind="newExpensePaidBy">
                        <option value="">—</option>
                        @foreach (var p in settlement.Participants)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="inline-form-field" style="flex:100%;margin-top:0;">
                    <label class="inline-form-label">@Strings.SETTLEMENT_DETAIL_EXPENSE_SPLIT</label>
                    <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);margin-top:var(--space-1);">                        
                        @foreach (var p in settlement.Participants)
                        {
                            var pid = p.Id;
                            var checked_ = newExpenseSplitAmong.Contains(pid);
                            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:var(--text-sm);padding:4px 10px;border-radius:var(--radius-full);border:1px solid @(checked_ ? "var(--color-accent)" : "var(--color-border)");background:@(checked_ ? "var(--color-accent)" : "transparent");color:@(checked_ ? "#fff" : "var(--color-text)");">
                                <input type="checkbox" style="display:none;"
                                       checked="@checked_"
                                       @onchange="() => ToggleSplitParticipant(pid)" />
                                @p.Name
                            </label>
                        }
                    </div>
                    @if (newExpenseSplitAmong.Count == 0)
                    {
                        <div style="display:flex;align-items:center;gap:var(--space-2);margin-top:var(--space-2);font-size:var(--text-xs);color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:var(--radius-md);padding:var(--space-2) var(--space-3);">
                            <span class="material-symbols-outlined" style="font-size:14px;">warning</span>
                            @Strings.SETTLEMENT_DETAIL_EXPENSE_SPLIT_ALL_WARNING
                        </div>
                    }
                </div>
                <button class="btn-primary" @onclick="AddExpenseAsync"
                        disabled="@(string.IsNullOrWhiteSpace(newExpenseLabel) || newExpenseAmount <= 0 || newExpensePaidBy == Guid.Empty)"
                        style="flex-shrink:0;align-self:flex-end;">
                    @Strings.SETTLEMENT_DETAIL_EXPENSE_ADD
                </button>
            </div>
        }

        @if (settlement.Expenses.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">receipt</span>
                <p>@Strings.SETTLEMENT_DETAIL_EXPENSE_EMPTY</p>
            </div>
        }
        else
        {
            <div class="item-list">
                @foreach (var e in settlement.Expenses)
                {
                    <div class="item-row">
                        <span class="item-row-label">@e.Label</span>
                        <span class="item-row-sub" style="white-space:nowrap;">
                            <span style="font-weight:500;color:var(--color-text-primary);">@ParticipantName(e.PaidByParticipantId)</span>
                            @if (e.SplitAmongParticipantIds.Count > 0)
                            {
                                <span class="material-symbols-outlined" style="font-size:13px;vertical-align:middle;margin:0 2px;color:var(--color-text-muted);">arrow_forward</span>
                                <span>@string.Join(", ", e.SplitAmongParticipantIds.Select(id => ParticipantName(id)))</span>
                            }
                        </span>
                        <span class="item-row-amount" style="white-space:nowrap;">@e.Amount.ToString("N0") ₩</span>
                        <span class="item-row-action">
                            @if (settlement.Status == SettlementStatus.Open && isOwner)
                            {
                                <button class="btn-ghost" @onclick="() => OpenEditExpenseAsync(e)">
                                    @Strings.BUTTON_EDIT
                                </button>
                                <button class="btn-danger" @onclick="() => RemoveExpenseAsync(e.Id)">
                                    @Strings.BUTTON_DELETE
                                </button>
                            }
                        </span>
                    </div>
                }
            </div>
        }
    }

    <!-- Participants Tab -->
    @if (activeTab == Tab.Participants)
    {
        @if (settlement.Status == SettlementStatus.Open && isOwner)
        {
            <div class="inline-form">
                <div class="inline-form-field">
                    <label class="inline-form-label">@Strings.SETTLEMENT_DETAIL_PARTICIPANT_NAME</label>
                    <input class="form-input" @bind="newParticipantName" @bind:event="oninput" placeholder="e.g. Alice" maxlength="50" />
                </div>
                <button class="btn-primary" @onclick="AddParticipantAsync"
                        disabled="@string.IsNullOrWhiteSpace(newParticipantName)"
                        style="flex-shrink:0;align-self:flex-end;">
                    @Strings.SETTLEMENT_DETAIL_PARTICIPANT_ADD
                </button>
            </div>
        }

        @if (settlement.Participants.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">group</span>
                <p>@Strings.SETTLEMENT_DETAIL_PARTICIPANT_EMPTY</p>
            </div>
        }
        else
        {
            <div class="item-list">
                @foreach (var p in settlement.Participants)
                {
                    <div class="item-row item-row-participant">
                        <span class="material-symbols-outlined" style="font-size:18px;color:var(--color-text-muted);">person</span>
                        <span class="item-row-label">@p.Name</span>
                        @if (settlement.Status == SettlementStatus.Open && isOwner)
                        {
                            <span class="item-row-action">
                                <button class="btn-danger" @onclick="() => RemoveParticipantAsync(p.Id)">
                                    @Strings.BUTTON_DELETE
                                </button>
                            </span>
                        }
                    </div>
                }
            </div>
        }
    }

    <!-- Result Tab -->
    @if (activeTab == Tab.Result)
    {
        <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-4);">
            <label style="display:flex;align-items:center;gap:var(--space-2);cursor:pointer;font-size:var(--text-sm);color:var(--color-text-muted);user-select:none;">
                <input type="checkbox" @bind="minimizeTransfers" @bind:after="RefreshTransfersAsync"
                       style="width:16px;height:16px;accent-color:var(--color-accent);cursor:pointer;" />
                최소 이체 모드
            </label>
            <span style="font-size:var(--text-xs);color:var(--color-text-muted);">
                @(minimizeTransfers ? "이체 횟수를 최소화합니다." : "항목별로 개별 지급합니다.")
            </span>
        </div>

        @if (isCalculating)
        {
            <div class="transfer-list">
                @for (int i = 0; i < 2; i++)
                {
                    <div class="transfer-card">
                        <span class="skeleton" style="width:200px;"></span>
                    </div>
                }
            </div>
        }
        else if (transfers.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined" style="color:var(--color-success);">check_circle</span>
                <p>@Strings.SETTLEMENT_DETAIL_RESULT_EMPTY</p>
            </div>
        }
        else
        {
            <div class="transfer-list">
                @foreach (var t in transfers)
                {
                    <div class="transfer-card">
                        <span class="transfer-from">@t.FromParticipantName</span>
                        <span class="material-symbols-outlined transfer-arrow">arrow_forward</span>
                        <span class="transfer-amount">@t.Amount.ToString("N0") ₩</span>
                        <span style="color:var(--color-text-muted);font-size:var(--text-sm);">@Strings.SETTLEMENT_DETAIL_RESULT_TO</span>
                        <span class="transfer-to">@t.ToParticipantName</span>
                    </div>
                }
            </div>
        }
    }
}

<EditExpenseDialog @ref="editExpenseDialog" OnSaved="LoadAsync" />

@code {
    [Parameter] public Guid Id { get; set; }

    private enum Tab { Expenses, Participants, Result }
    private Tab activeTab = Tab.Expenses;

    private Settlement? settlement;
    private bool isLoading = true;
    private bool isCalculating = false;

    // New expense form
    private string newExpenseLabel = string.Empty;
    private decimal newExpenseAmount;
    private Guid newExpensePaidBy;
    private HashSet<Guid> newExpenseSplitAmong = [];

    private void InitSplitAmong()
    {
        newExpenseSplitAmong = settlement?.Participants.Select(p => p.Id).ToHashSet() ?? [];
    }

    // New participant form
    private string newParticipantName = string.Empty;

    // Result
    private bool minimizeTransfers = false;
    private List<TransferInstruction> transfers = [];

    // Auth state
    private bool isAuthenticated = false;
    private bool isOwner = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var auth = await AuthState.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated ?? false;
        await LoadAsync();
    }

    // Called after LoadAsync so settlement is available
    private void UpdateOwnerState(System.Security.Claims.ClaimsPrincipal user)
    {
        if (!isAuthenticated || settlement is null)
        {
            isOwner = false;
            return;
        }
        var sub = user.FindFirst("sub")?.Value
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        isOwner = sub is not null && sub == settlement.OwnerSubject;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        StateHasChanged();

        settlement = await SettlementService.GetSettlementAsync(Id);
        isLoading = false;

        var auth = await AuthState.GetAuthenticationStateAsync();
        UpdateOwnerState(auth.User);

        StateHasChanged();

        if (settlement is not null)
        {
            InitSplitAmong();
            await RefreshTransfersAsync();
        }
    }

    private async Task RefreshTransfersAsync()
    {
        isCalculating = true;
        StateHasChanged();
        transfers = [.. await ExpenseService.CalculateTransfersAsync(Id, minimizeTransfers)];
        isCalculating = false;
        StateHasChanged();
    }

    private async Task AddExpenseAsync()
    {
        if (settlement is null || string.IsNullOrWhiteSpace(newExpenseLabel) || newExpensePaidBy == Guid.Empty) return;
        await ExpenseService.AddExpenseAsync(Id, newExpenseLabel.Trim(), newExpenseAmount, newExpensePaidBy,
            newExpenseSplitAmong.Count > 0 ? newExpenseSplitAmong : null);
        newExpenseLabel = string.Empty;
        newExpenseAmount = 0;
        newExpensePaidBy = Guid.Empty;
        await LoadAsync();
    }

    private void ToggleSplitParticipant(Guid id)
    {
        if (!newExpenseSplitAmong.Remove(id))
            newExpenseSplitAmong.Add(id);
    }

    private async Task RemoveExpenseAsync(Guid expenseId)
    {
        await ExpenseService.RemoveExpenseAsync(expenseId);
        await LoadAsync();
    }

    private async Task AddParticipantAsync()
    {
        if (string.IsNullOrWhiteSpace(newParticipantName)) return;
        await ParticipantService.AddParticipantAsync(Id, newParticipantName.Trim());
        newParticipantName = string.Empty;
        await LoadAsync();
    }

    private async Task RemoveParticipantAsync(Guid participantId)
    {
        await ParticipantService.RemoveParticipantAsync(participantId);
        await LoadAsync();
    }

    private async Task CloseSettlementAsync()
    {
        await SettlementService.CloseSettlementAsync(Id);
        await LoadAsync();
    }

    private EditExpenseDialog editExpenseDialog = default!;

    private Task OpenEditExpenseAsync(Expense e)
    {
        return editExpenseDialog.OpenAsync(e, settlement!.Participants.ToList());
    }

    private string ParticipantName(Guid id) =>
        settlement?.Participants.FirstOrDefault(p => p.Id == id)?.Name ?? "?";
}
