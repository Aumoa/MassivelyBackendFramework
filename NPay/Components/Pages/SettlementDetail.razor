@page "/settlements/{Id:guid}"
@rendermode InteractiveServer
@using NPay.Models
@using NPay.Services
@inject ISettlementService SettlementService
@inject IParticipantService ParticipantService
@inject IExpenseService ExpenseService
@inject NavigationManager Nav

<PageTitle>@(settlement?.Title ?? Strings.LOADING) — @Strings.APP_TITLE</PageTitle>

@if (isLoading)
{
    <p class="text-muted">@Strings.LOADING</p>
}
else if (settlement is null)
{
    <div class="alert alert-warning">@Strings.SETTLEMENT_DETAIL_NOT_FOUND</div>
}
else
{
    <div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <h1>@settlement.Title</h1>
            @if (!string.IsNullOrWhiteSpace(settlement.Description))
            {
                <p>@settlement.Description</p>
            }
        </div>
        @if (settlement.Status == SettlementStatus.Open)
        {
            <button class="btn-primary-npay" @onclick="CloseSettlementAsync">
                <span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle;">lock</span>
                @Strings.SETTLEMENT_DETAIL_BUTTON_CLOSE
            </button>
        }
        else
        {
            <span class="badge-closed">@Strings.SETTLEMENTS_STATUS_CLOSED</span>
        }
    </div>

    <!-- Tabs -->
    <div class="npay-tabs">
        <button class="npay-tab @(activeTab == Tab.Expenses ? "active" : "")" @onclick="() => activeTab = Tab.Expenses">
            @Strings.SETTLEMENT_DETAIL_TAB_EXPENSES
        </button>
        <button class="npay-tab @(activeTab == Tab.Participants ? "active" : "")" @onclick="() => activeTab = Tab.Participants">
            @Strings.SETTLEMENT_DETAIL_TAB_PARTICIPANTS
        </button>
        <button class="npay-tab @(activeTab == Tab.Result ? "active" : "")" @onclick="() => activeTab = Tab.Result">
            @Strings.SETTLEMENT_DETAIL_TAB_RESULT
        </button>
    </div>

    <!-- Expenses Tab -->
    @if (activeTab == Tab.Expenses)
    {
        @if (settlement.Status == SettlementStatus.Open && settlement.Participants.Count > 0)
        {
            <div class="npay-card mb-4">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-sm-4">
                        <label class="form-label fw-semibold">@Strings.SETTLEMENT_DETAIL_EXPENSE_LABEL</label>
                        <input class="form-control" @bind="newExpenseLabel" placeholder="e.g. Beer" maxlength="100" />
                    </div>
                    <div class="col-6 col-sm-2">
                        <label class="form-label fw-semibold">@Strings.SETTLEMENT_DETAIL_EXPENSE_AMOUNT</label>
                        <input class="form-control" type="number" min="1" @bind="newExpenseAmount" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label fw-semibold">@Strings.SETTLEMENT_DETAIL_EXPENSE_PAID_BY</label>
                        <select class="form-select" @bind="newExpensePaidBy">
                            <option value="">—</option>
                            @foreach (var p in settlement.Participants)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-sm-3 d-flex align-items-end">
                        <button class="btn-primary-npay w-100" @onclick="AddExpenseAsync"
                                disabled="@(string.IsNullOrWhiteSpace(newExpenseLabel) || newExpenseAmount <= 0 || newExpensePaidBy == Guid.Empty)">
                            @Strings.SETTLEMENT_DETAIL_EXPENSE_ADD
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (settlement.Expenses.Count == 0)
        {
            <p class="text-muted">@Strings.SETTLEMENT_DETAIL_EXPENSE_EMPTY</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@Strings.SETTLEMENT_DETAIL_EXPENSE_LABEL</th>
                            <th>@Strings.SETTLEMENT_DETAIL_EXPENSE_AMOUNT</th>
                            <th>@Strings.SETTLEMENT_DETAIL_EXPENSE_PAID_BY</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in settlement.Expenses)
                        {
                            <tr>
                                <td>@e.Label</td>
                                <td>@e.Amount.ToString("N0") ₩</td>
                                <td>@ParticipantName(e.PaidByParticipantId)</td>
                                <td>
                                    @if (settlement.Status == SettlementStatus.Open)
                                    {
                                        <button class="link-button text-danger" @onclick="() => RemoveExpenseAsync(e.Id)">
                                            @Strings.BUTTON_DELETE
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <!-- Participants Tab -->
    @if (activeTab == Tab.Participants)
    {
        @if (settlement.Status == SettlementStatus.Open)
        {
            <div class="npay-card mb-4">
                <div class="d-flex gap-2 align-items-end">
                    <div class="flex-grow-1">
                        <label class="form-label fw-semibold">@Strings.SETTLEMENT_DETAIL_PARTICIPANT_NAME</label>
                        <input class="form-control" @bind="newParticipantName" placeholder="e.g. Alice" maxlength="50" />
                    </div>
                    <button class="btn-primary-npay" @onclick="AddParticipantAsync"
                            disabled="@string.IsNullOrWhiteSpace(newParticipantName)">
                        @Strings.SETTLEMENT_DETAIL_PARTICIPANT_ADD
                    </button>
                </div>
            </div>
        }

        @if (settlement.Participants.Count == 0)
        {
            <p class="text-muted">@Strings.SETTLEMENT_DETAIL_PARTICIPANT_EMPTY</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var p in settlement.Participants)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle;color:#6d28d9;">person</span>
                            @p.Name
                        </span>
                        @if (settlement.Status == SettlementStatus.Open)
                        {
                            <button class="link-button text-danger" @onclick="() => RemoveParticipantAsync(p.Id)">
                                @Strings.BUTTON_DELETE
                            </button>
                        }
                    </li>
                }
            </ul>
        }
    }

    <!-- Result Tab -->
    @if (activeTab == Tab.Result)
    {
        @if (isCalculating)
        {
            <p class="text-muted">@Strings.LOADING</p>
        }
        else if (transfers.Count == 0)
        {
            <div class="npay-card text-center py-4 text-muted">
                <span class="material-symbols-outlined" style="font-size:3rem;color:#10b981;">check_circle</span>
                <p class="mt-2 mb-0 fw-semibold">@Strings.SETTLEMENT_DETAIL_RESULT_EMPTY</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var t in transfers)
                {
                    <div class="transfer-card">
                        <span class="material-symbols-outlined" style="color:#6d28d9;">arrow_forward</span>
                        <span><strong>@t.FromParticipantName</strong></span>
                        <span class="text-muted">@Strings.SETTLEMENT_DETAIL_RESULT_PAYS</span>
                        <span class="amount">@t.Amount.ToString("N0") ₩</span>
                        <span class="text-muted">@Strings.SETTLEMENT_DETAIL_RESULT_TO</span>
                        <span><strong>@t.ToParticipantName</strong></span>
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private enum Tab { Expenses, Participants, Result }
    private Tab activeTab = Tab.Expenses;

    private Settlement? settlement;
    private bool isLoading = true;
    private bool isCalculating = false;

    // New expense form
    private string newExpenseLabel = string.Empty;
    private decimal newExpenseAmount;
    private Guid newExpensePaidBy;

    // New participant form
    private string newParticipantName = string.Empty;

    // Result
    private List<TransferInstruction> transfers = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        StateHasChanged();

        settlement = await SettlementService.GetSettlementAsync(Id);
        isLoading = false;
        StateHasChanged();

        if (settlement is not null)
            await RefreshTransfersAsync();
    }

    private async Task RefreshTransfersAsync()
    {
        isCalculating = true;
        StateHasChanged();
        transfers = [.. await ExpenseService.CalculateTransfersAsync(Id)];
        isCalculating = false;
        StateHasChanged();
    }

    private async Task AddExpenseAsync()
    {
        if (settlement is null || string.IsNullOrWhiteSpace(newExpenseLabel) || newExpensePaidBy == Guid.Empty) return;
        await ExpenseService.AddExpenseAsync(Id, newExpenseLabel.Trim(), newExpenseAmount, newExpensePaidBy);
        newExpenseLabel = string.Empty;
        newExpenseAmount = 0;
        newExpensePaidBy = Guid.Empty;
        await LoadAsync();
    }

    private async Task RemoveExpenseAsync(Guid expenseId)
    {
        await ExpenseService.RemoveExpenseAsync(expenseId);
        await LoadAsync();
    }

    private async Task AddParticipantAsync()
    {
        if (string.IsNullOrWhiteSpace(newParticipantName)) return;
        await ParticipantService.AddParticipantAsync(Id, newParticipantName.Trim());
        newParticipantName = string.Empty;
        await LoadAsync();
    }

    private async Task RemoveParticipantAsync(Guid participantId)
    {
        await ParticipantService.RemoveParticipantAsync(participantId);
        await LoadAsync();
    }

    private async Task CloseSettlementAsync()
    {
        await SettlementService.CloseSettlementAsync(Id);
        await LoadAsync();
    }

    private string ParticipantName(Guid id) =>
        settlement?.Participants.FirstOrDefault(p => p.Id == id)?.Name ?? "?";
}
