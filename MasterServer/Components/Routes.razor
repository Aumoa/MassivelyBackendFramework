<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized Context="routeAuth">
                    <AuthorizeView>
                        <Authorized Context="userAuth">
                            <LayoutView Layout="typeof(Layout.MainLayout)">
                                <BlazorSharedComponent.ErrorView ErrorTextBody="@Strings.ACCESS_DENIED_TITLE" ErrorText="@Strings.ACCESS_DENIED_DESCRIPTION" />
                            </LayoutView>
                        </Authorized>
                        <NotAuthorized Context="anonymousAuth">
                            <RedirectToLogin />
                        </NotAuthorized>
                    </AuthorizeView>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
