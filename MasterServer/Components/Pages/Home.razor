@page "/"
@attribute [Authorize(Policy = MasterAuthorizationPolicies.Admin)]
@inject IConnectionManager ConnectionManager

<PageTitle>@Strings.APP_TITLE</PageTitle>

<section class="dashboard-header">
    <div>
        <p class="eyebrow">@Strings.HOME_EYEBROW</p>
        <h1>@Strings.HOME_TITLE</h1>
        <p class="summary">@Strings.HOME_SUMMARY</p>
    </div>
</section>

<section class="metrics-grid" aria-label="@Strings.HOME_SUMMARY_ARIA">
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_SOCKET_ENDPOINT</span>
        <strong>@EndpointText</strong>
        <span class="metric-detail">@TlsText</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_ACTIVE_CONNECTIONS</span>
        <strong>@Connections.Count</strong>
        <span class="metric-detail">@Strings.METRIC_ACTIVE_CONNECTIONS_DETAIL</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_CONTROL_MODE</span>
        <strong>@Strings.METRIC_CONTROL_MODE_VALUE</strong>
        <span class="metric-detail">@Strings.METRIC_CONTROL_MODE_DETAIL</span>
    </article>
</section>

<section class="connection-panel">
    <div class="panel-heading">
        <div>
            <h2>@Strings.CONNECTIONS_TITLE</h2>
            <p>@Strings.CONNECTIONS_DESCRIPTION</p>
        </div>
        <span class="status-pill">@string.Format(Strings.CONNECTIONS_ACTIVE_FORMAT, Connections.Count)</span>
    </div>

    @if (Connections.Count == 0)
    {
        <div class="empty-state">
            <strong>@Strings.CONNECTIONS_EMPTY_TITLE</strong>
            <span>@Strings.CONNECTIONS_EMPTY_DESCRIPTION</span>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>@Strings.CONNECTIONS_TABLE_CONNECTION</th>
                        <th>@Strings.CONNECTIONS_TABLE_ROLE</th>
                        <th>@Strings.CONNECTIONS_TABLE_REMOTE_ENDPOINT</th>
                        <th>@Strings.CONNECTIONS_TABLE_CONNECTED</th>
                        <th>@Strings.CONNECTIONS_TABLE_LAST_SEEN</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var connection in Connections)
                    {
                        <tr>
                            <td><code>@connection.ConnectionId.ToString("N")[..8]</code></td>
                            <td>@GetNodeKindText(connection.NodeKind)</td>
                            <td>@connection.RemoteEndPoint</td>
                            <td>@connection.ConnectedAt.LocalDateTime</td>
                            <td>@connection.LastSeenAt.LocalDateTime</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private MasterSocketEndpoint Endpoint { get; set; } = new("unknown", 0, false);

    private IReadOnlyCollection<MasterConnectionSnapshot> Connections { get; set; } = [];

    private string EndpointText => $"{Endpoint.IPAddress}:{Endpoint.Port}";

    private string TlsText => Endpoint.UseTls ? Strings.TLS_ENABLED : Strings.TLS_DISABLED;

    protected override void OnInitialized()
    {
        Endpoint = ConnectionManager.GetSocketEndpoint();
        Connections = ConnectionManager.GetConnectionSnapshots();
    }

    private static string GetNodeKindText(MasterNodeKind nodeKind)
    {
        return nodeKind switch
        {
            MasterNodeKind.Gateway => Strings.NODE_KIND_GATEWAY,
            MasterNodeKind.Dedicated => Strings.NODE_KIND_DEDICATED,
            _ => Strings.NODE_KIND_UNKNOWN
        };
    }
}
