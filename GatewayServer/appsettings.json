{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MySql": {
    "Server": "localhost",
    "Port": 3306,
    "Database": "MassivelyBackendFramework__GatewayServer",
    "User": "REPLACE_WITH_DB_USER",
    "Password": "REPLACE_WITH_DB_PASSWORD"
  },
  "ConnectionManager": {
    "IPAddress": "::1",
    "Port": 11501,
    "UseTls": true
  },
  "MasterConnection": {
    "Enabled": true,
    "IPAddress": "::1",
    "Port": 11601,
    "UseTls": false,
    "ServerName": "localhost",
    "NodeId": "gateway-local",
    "DisplayName": "Gateway",
    "SharedSecret": "development-node-auth-secret",
    "ReconnectDelayMilliseconds": 5000,
    "HandshakeTimeoutMilliseconds": 5000
  }
}
