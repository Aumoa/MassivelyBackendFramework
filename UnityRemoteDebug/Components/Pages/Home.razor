@page "/"
@attribute [Authorize(Policy = RemoteDebugAuthorizationPolicies.Management)]
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RemoteDebugClientRegistry ClientRegistry

<PageTitle>@Strings.APP_TITLE</PageTitle>

<section class="dashboard-header">
    <div>
        <p class="eyebrow">@Strings.HOME_EYEBROW</p>
        <h1>@Strings.HOME_TITLE</h1>
        <p class="summary">@Strings.HOME_SUMMARY</p>
    </div>
</section>

<section class="metrics-grid" aria-label="@Strings.HOME_SUMMARY_ARIA">
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_AUTHORITY</span>
        <strong>@Strings.METRIC_AUTHORITY_VALUE</strong>
        <span class="metric-detail">@Strings.METRIC_AUTHORITY_DETAIL</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_ACCESS</span>
        <strong>@m_AccessValue</strong>
        <span class="metric-detail">@Strings.METRIC_ACCESS_DETAIL</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_BACKEND</span>
        <strong>@m_Clients.Count</strong>
        <span class="metric-detail">@Strings.METRIC_BACKEND_DETAIL</span>
    </article>
</section>

<section class="workspace-panel">
    <div class="panel-heading">
        <div>
            <h2>@Strings.CLIENTS_TITLE</h2>
            <p>@Strings.CLIENTS_DESCRIPTION</p>
        </div>
        <div class="panel-actions">
            <span class="status-pill">@string.Format(Strings.CLIENTS_CONNECTED_FORMAT, m_Clients.Count)</span>
            <button class="icon-button" type="button" title="@Strings.CLIENTS_REFRESH" @onclick="RefreshClientsAsync" disabled="@m_IsRefreshing">
                <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
            </button>
        </div>
    </div>

    @if (m_Clients.Count == 0)
    {
        <div class="empty-state">
            <strong>@Strings.CLIENTS_EMPTY_TITLE</strong>
            <span>@Strings.CLIENTS_EMPTY_DESCRIPTION</span>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>@Strings.CLIENTS_TABLE_CLIENT</th>
                        <th>@Strings.CLIENTS_TABLE_PROJECT</th>
                        <th>@Strings.CLIENTS_TABLE_PLATFORM</th>
                        <th>@Strings.CLIENTS_TABLE_UNITY</th>
                        <th>@Strings.CLIENTS_TABLE_REMOTE</th>
                        <th>@Strings.CLIENTS_TABLE_CONNECTED</th>
                        <th>@Strings.CLIENTS_TABLE_LAST_SEEN</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in m_Clients)
                    {
                        <tr>
                            <td>
                                <strong>@client.DisplayName</strong>
                                <code>@client.ClientId.ToString("N")[..8]</code>
                            </td>
                            <td>@client.ProjectName</td>
                            <td>@client.Platform</td>
                            <td>@client.UnityVersion</td>
                            <td>@client.RemoteEndPoint</td>
                            <td>@FormatDateTime(client.ConnectedAt)</td>
                            <td>@FormatDateTime(client.LastSeenAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private IReadOnlyList<RemoteDebugClientSnapshot> m_Clients = [];
    private string m_AccessValue = Strings.METRIC_ACCESS_UNKNOWN_VALUE;
    private bool m_IsRefreshing;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        m_AccessValue = ResolveAccessValue(authenticationState.User);

        RefreshClients();
        ClientRegistry.Changed += OnClientRegistryChanged;
    }

    public void Dispose()
    {
        ClientRegistry.Changed -= OnClientRegistryChanged;
        GC.SuppressFinalize(this);
    }

    private async Task RefreshClientsAsync()
    {
        m_IsRefreshing = true;
        await Task.Yield();
        RefreshClients();
        m_IsRefreshing = false;
    }

    private void RefreshClients()
    {
        m_Clients = ClientRegistry.GetClients();
    }

    private void OnClientRegistryChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshClients();
            StateHasChanged();
        });
    }

    private static string FormatDateTime(DateTimeOffset value)
    {
        return value.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string ResolveAccessValue(System.Security.Claims.ClaimsPrincipal user)
    {
        if (RemoteDebugAuthorizationPolicies.HasAdminGroup(user))
        {
            return Strings.METRIC_ACCESS_ADMIN_VALUE;
        }

        if (RemoteDebugAuthorizationPolicies.HasStaffGroup(user))
        {
            return Strings.METRIC_ACCESS_STAFF_VALUE;
        }

        return Strings.METRIC_ACCESS_UNKNOWN_VALUE;
    }
}
