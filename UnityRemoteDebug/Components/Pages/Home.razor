@page "/"
@attribute [Authorize(Policy = RemoteDebugAuthorizationPolicies.Management)]

<PageTitle>@Strings.APP_TITLE</PageTitle>

<section class="dashboard-header">
    <div>
        <p class="eyebrow">@Strings.HOME_EYEBROW</p>
        <h1>@Strings.HOME_TITLE</h1>
        <p class="summary">@Strings.HOME_SUMMARY</p>
    </div>
</section>

<section class="metrics-grid" aria-label="@Strings.HOME_SUMMARY_ARIA">
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_AUTHORITY</span>
        <strong>@Strings.METRIC_AUTHORITY_VALUE</strong>
        <span class="metric-detail">@Strings.METRIC_AUTHORITY_DETAIL</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_ACCESS</span>
        <strong>@Strings.METRIC_ACCESS_VALUE</strong>
        <span class="metric-detail">@Strings.METRIC_ACCESS_DETAIL</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">@Strings.METRIC_BACKEND</span>
        <strong>@Strings.METRIC_BACKEND_VALUE</strong>
        <span class="metric-detail">@Strings.METRIC_BACKEND_DETAIL</span>
    </article>
</section>

<section class="workspace-panel">
    <div class="panel-heading">
        <div>
            <h2>@Strings.PANEL_TITLE</h2>
            <p>@Strings.PANEL_DESCRIPTION</p>
        </div>
        <span class="status-pill">@Strings.PANEL_STATUS_VALUE</span>
    </div>

    <div class="panel-grid">
        <article class="info-block">
            <span class="info-label">@Strings.PANEL_STATUS_LABEL</span>
            <strong>@Strings.PANEL_STATUS_VALUE</strong>
            <p>@Strings.PANEL_STATUS_DETAIL</p>
        </article>
        <article class="info-block">
            <span class="info-label">@Strings.PANEL_SCOPE_LABEL</span>
            <strong>@Strings.PANEL_SCOPE_VALUE</strong>
            <p>@Strings.PANEL_SCOPE_DETAIL</p>
        </article>
    </div>

    <div class="next-block">
        <h3>@Strings.PANEL_NEXT_TITLE</h3>
        <ul>
            <li>@Strings.PANEL_NEXT_ITEM_SESSION</li>
            <li>@Strings.PANEL_NEXT_ITEM_DEVICE</li>
            <li>@Strings.PANEL_NEXT_ITEM_LOGS</li>
        </ul>
    </div>
</section>
